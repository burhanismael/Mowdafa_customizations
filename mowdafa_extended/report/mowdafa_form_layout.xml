<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ══════════════════════════════════════════════════════════════════
     The MOWDAFA form-report design system — ONE look for every form PDF
     (GBV and Child Protection, generic and fixed layouts alike):
       report_mowdafa_styles  the stylesheet
       report_mowdafa_title   title block: doc type, reference, subtitle,
                              optional status badge
       report_mowdafa_rows    field grid: "Label: value", two per row;
                              notes and drawn signatures in boxes
     ══════════════════════════════════════════════════════════════════ -->

<template id="report_mowdafa_styles">
  <style type="text/css">
    .mr-page { font-family: "DejaVu Sans", Arial, sans-serif;
               color: #263445; font-size: 10.5px; line-height: 1.4; }

    /* keep the company layout's zebra rows (Striped:
       .o_report_layout_striped tbody tr:nth-child(odd)) off our tables */
    .mr-page table, .mr-page tbody, .mr-page tr,
    .mr-page td { background: transparent; color: inherit; }
    .mr-page table tbody tr:nth-child(odd),
    .mr-page table tbody tr:nth-child(even) {
        background-color: transparent !important; }
    .mr-page table { border: 0; }

    /* title block */
    .mr-head { border-left: 5px solid #24465a;
               border-bottom: 1px solid #dfe6eb;
               padding: 3px 0 10px 13px; margin: 0 0 12px;
               page-break-inside: avoid; }
    .mr-head-side { float: right; text-align: right; margin-left: 14px; }
    .mr-doctype { font-size: 9px; letter-spacing: 2px;
                  text-transform: uppercase; color: #7a8c99; }
    .mr-ref { font-size: 22px; line-height: 1.2; font-weight: bold;
              color: #24465a; margin: 2px 0 1px; }
    .mr-sub { font-size: 13px; color: #37424e; }
    .mr-badge-lbl { display: block; font-size: 7.5px; letter-spacing: 1.5px;
                    text-transform: uppercase; color: #7a8c99;
                    margin-bottom: 3px; }
    .mr-badge { display: inline-block; white-space: nowrap;
                padding: 4px 12px; border-radius: 12px;
                background: #24465a; color: #fff;
                font-size: 9px; font-weight: bold; }
    .mr-photo { display: block; margin: 8px 0 0 auto; max-width: 70px;
                max-height: 82px; border: 1px solid #d5dfe5; padding: 2px; }
    .mr-clear { clear: both; }

    /* section bar */
    .mr-sec { background: #edf3f5; color: #24465a;
              border-left: 3px solid #387d89; font-weight: bold;
              font-size: 10.5px; padding: 5px 9px; margin: 11px 0 0;
              page-break-after: avoid; }

    /* field grid: "Label: value" */
    .mr-rows { width: 100%; border-collapse: collapse; table-layout: fixed; }
    .mr-rows tr { page-break-inside: avoid; }
    .mr-page .mr-rows td { border: 1px solid #dfe6eb; padding: 4px 8px;
                           vertical-align: top; word-wrap: break-word; }
    .mr-lbl { font-size: 9.5px; font-weight: bold; color: #24465a; }
    .mr-val { font-size: 10.5px; color: #14181b; }
    .mr-note { font-size: 10.5px; color: #14181b; white-space: pre-wrap;
               margin-top: 1px; }
    .mr-sign-cell { height: 46px; border-bottom: 1px solid #8b97a5;
                    text-align: center; margin: 1px 8px 2px; }
    .mr-sign-img { max-height: 44px; max-width: 100%; }

    /* tables: line tables and signing blocks */
    .mr-tbl { width: 100%; border-collapse: collapse; table-layout: fixed; }
    .mr-tbl tr { page-break-inside: avoid; }
    .mr-page .mr-tbl th { background: #24465a; color: #fff;
                          font-size: 8.5px; font-weight: bold;
                          letter-spacing: 0.5px; text-align: left;
                          padding: 5px 7px; border: 1px solid #24465a; }
    .mr-page .mr-tbl td { border: 1px solid #dfe6eb; padding: 4px 7px;
                          font-size: 9.5px; vertical-align: top;
                          word-wrap: break-word; }
    .mr-page .mr-tbl tr:nth-child(even) td { background: #f7f9fa; }
    .mr-page .mr-tbl td.mr-rl { background: #f7f9fa; font-weight: bold;
                                color: #24465a; }
    .mr-page .mr-tbl td.mr-sign { height: 64px; text-align: center;
                                  vertical-align: bottom;
                                  background: #fff; }
    .mr-sign-line { border-top: 1px solid #8b97a5; margin-top: 3px;
                    padding-top: 2px; font-size: 7.5px; color: #7a8c99; }
    .mr-keep { page-break-inside: avoid; }
  </style>
</template>

<!-- title block — set mr_doctype, mr_ref, and optionally mr_sub,
     mr_badge_lbl + mr_badge, mr_photo -->
<template id="report_mowdafa_title">
  <div class="mr-head">
    <div t-if="mr_badge or mr_photo" class="mr-head-side">
      <t t-if="mr_badge">
        <span class="mr-badge-lbl"><t t-esc="mr_badge_lbl or 'Status'"/></span>
        <span class="mr-badge"><t t-esc="mr_badge"/></span>
      </t>
      <img t-if="mr_photo" class="mr-photo"
           t-att-src="image_data_uri(mr_photo)" alt="Photo"/>
    </div>
    <div class="mr-doctype"><t t-esc="mr_doctype"/></div>
    <div class="mr-ref"><t t-esc="mr_ref"/></div>
    <div t-if="mr_sub" class="mr-sub"><t t-esc="mr_sub"/></div>
    <div class="mr-clear"/>
  </div>
</template>

<!-- field grid — set mr_rows (from helper.grid() or helper.layout()) -->
<template id="report_mowdafa_rows">
  <table class="mr-rows">
    <t t-foreach="mr_rows" t-as="row">
      <tr>
        <t t-foreach="row" t-as="cell">
          <td t-att-colspan="2 if len(row) == 1 else None">
            <span class="mr-lbl"><t t-esc="cell['label']"/>:</span>
            <t t-if="'image' in cell">
              <div class="mr-sign-cell">
                <img t-if="cell['image']" class="mr-sign-img"
                     t-att-src="image_data_uri(cell['image'])"
                     alt="Signature"/>
              </div>
            </t>
            <t t-elif="cell.get('note') or cell['long']">
              <div class="mr-note"
                   t-att-style="'min-height: 40px;' if not cell['value'] else None"><t t-esc="cell['value']"/></div>
            </t>
            <t t-else="">
              <span class="mr-val"><t t-esc="cell['value']"/></span>
            </t>
          </td>
        </t>
      </tr>
    </t>
  </table>
</template>

<!-- the generic form document: mirrors each model's form view -->
<template id="report_mowdafa_form_document">
  <t t-call="web.html_container">
    <t t-foreach="docs" t-as="doc">
      <t t-set="o" t-value="doc"/>
      <t t-call="web.external_layout">
        <t t-set="helper" t-value="doc.env['mowdafa.pdf.helper']"/>
        <div class="page mr-page">
          <t t-call="mowdafa_extended.report_mowdafa_styles"/>
          <t t-call="mowdafa_extended.report_mowdafa_title">
            <t t-set="mr_doctype" t-value="doc._description"/>
            <t t-set="mr_ref" t-value="doc.display_name"/>
          </t>

          <t t-set="layout" t-value="helper.layout(doc)"/>
          <t t-foreach="layout['blocks']" t-as="block">
            <div t-if="block['title']" class="mr-sec">
              <t t-esc="block['title']"/></div>
            <t t-if="block['kind'] == 'rows'">
              <t t-call="mowdafa_extended.report_mowdafa_rows">
                <t t-set="mr_rows" t-value="block['rows']"/>
              </t>
            </t>
            <t t-if="block['kind'] == 'table'">
              <table class="mr-tbl">
                <tr>
                  <t t-foreach="block['columns']" t-as="col">
                    <th><t t-esc="col"/></th>
                  </t>
                </tr>
                <t t-foreach="block['rows']" t-as="line">
                  <tr>
                    <t t-foreach="line" t-as="cell">
                      <td><t t-esc="cell"/></td>
                    </t>
                  </tr>
                </t>
              </table>
            </t>
          </t>
        </div>
      </t>
    </t>
  </t>
</template>

</odoo>
