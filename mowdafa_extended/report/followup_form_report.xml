<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- Follow-up Form — printed with the generic form layout (report/mowdafa_form_layout.xml) -->
<template id="report_form_followup_form">
  <t t-call="mowdafa_extended.report_mowdafa_form_document"/>
</template>

<record id="action_report_form_followup_form" model="ir.actions.report">
  <field name="name">Follow-up Form</field>
  <field name="model">followup.form</field>
  <field name="report_type">qweb-pdf</field>
  <field name="report_name">mowdafa_extended.report_form_followup_form</field>
  <field name="report_file">mowdafa_extended.report_form_followup_form</field>
  <field name="print_report_name">'Follow-up Form - %s' % (object.display_name)</field>
  <field name="binding_model_id" ref="model_followup_form"/>
  <field name="binding_type">report</field>
</record>

</odoo>
