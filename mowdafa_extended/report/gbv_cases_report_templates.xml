<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="report_gbv_cases_document">
  <t t-call="web.html_container">
    <t t-foreach="blocks" t-as="block">
      <t t-call="web.external_layout">
        <div class="page">
          <style type="text/css">
            .gbv-matrix-page {
              font-family: "DejaVu Sans", Arial, Helvetica, sans-serif;
              color: #1d252b;
              font-size: 12px;
            }
            .gbv-matrix {
              width: 100%;
              border-collapse: collapse;
              border: 1.4px solid #6f777d;
              table-layout: fixed;
            }
            .gbv-matrix th,
            .gbv-matrix td {
              border: 1px solid #8f979d;
              padding: 6px 4px;
              text-align: center;
              line-height: 1.2;
              font-size: 12px;
              font-weight: bold;
              color: #1d252b;
            }
            .gbv-matrix th {
              background: #edf4f6;
              font-size: 10px;
              letter-spacing: 0.2px;
              text-transform: uppercase;
            }
            .gbv-matrix .no-col {
              width: 30px;
            }
            .gbv-matrix .region-col {
              width: 106px;
              text-align: left;
              padding-left: 7px;
            }
            .gbv-matrix .total-col,
            .gbv-matrix .total-cell {
              width: 68px;
              background: #f6d7dc;
            }
            .gbv-matrix .no-data {
              text-align: center;
              background: #ffffff;
              font-weight: bold;
            }
            .gbv-matrix .grand-total td {
              background: #f6d7dc;
              font-weight: bold;
            }
            .gbv-card-title {
              margin: 16px 0 13px;
              padding-top: 11px;
              border-top: 1.3px solid #2d343a;
              text-align: center;
              font-size: 16px;
              font-weight: bold;
              letter-spacing: 0.2px;
              color: #1d252b;
            }
            .gbv-cards {
              width: 100%;
              border-collapse: separate;
              border-spacing: 0 11px;
            }
            .gbv-cards > tbody > tr > td {
              width: 33.33%;
              border: 0;
              padding: 0 11px 9px 0;
              vertical-align: top;
            }
            .gbv-card {
              border: 1px solid #6f767c;
              background: #ffffff;
            }
            .gbv-card-head {
              padding: 8px 9px;
              color: #ffffff;
              font-size: 13.5px;
              font-weight: bold;
              line-height: 1.2;
              letter-spacing: 0.2px;
            }
            .gbv-card table {
              width: 100%;
              border-collapse: collapse;
              table-layout: fixed;
            }
            .gbv-card td {
              border: 1px solid #6f767c;
              padding: 6px 7px;
              color: #1d252b;
              font-size: 12px;
              line-height: 1.25;
              font-weight: bold;
            }
            .gbv-card .seq {
              width: 38px;
              text-align: left;
            }
            .gbv-card .count {
              width: 34px;
              text-align: left;
            }
            .gbv-card .card-total td {
              color: #ffffff;
              font-size: 12px;
              padding: 7px;
            }
            .gbv-card .card-total .count {
              background: #ffffff;
              color: #1d252b;
            }
            .gbv-page-2 {
              page-break-before: always;
              padding-top: 4px;
            }
            .gbv-panels {
              width: 100%;
              border-collapse: separate;
              border-spacing: 9px 0;
              table-layout: fixed;
            }
            .gbv-panels > tbody > tr > td {
              width: 50%;
              padding: 0;
              vertical-align: top;
            }
            .gbv-banner {
              padding: 15px 12px;
              text-align: center;
              font-size: 14px;
              font-weight: bold;
              line-height: 1.4;
              letter-spacing: 0.3px;
              color: #1d252b;
            }
            .gbv-banner-chart {
              background: #d7dbea;
            }
            .gbv-banner-sex {
              background: #cfe7f7;
            }
            .gbv-panel-body {
              padding: 14px 2px 0;
            }
            /* wkhtmltopdf's WebKit collapses an SVG sized with a
               percentage width and automatic height, so every chart
               below carries explicit pixel dimensions instead. */
            .gbv-svg {
              display: block;
              margin: 0 auto;
            }
            .gbv-page-2 table,
            .gbv-page-2 td {
              border: 0 !important;
            }
            .gbv-pie-caption {
              text-align: center;
              font-size: 12px;
              font-weight: bold;
              color: #c9821a;
              margin-bottom: 3px;
            }
            .gbv-legend {
              margin-top: 8px;
              text-align: center;
              font-size: 11.5px;
              font-weight: bold;
              color: #3b4248;
            }
            .gbv-legend .item {
              margin: 0 7px;
              white-space: nowrap;
            }
            .swatch {
              display: inline-block;
              width: 8px;
              height: 8px;
              margin-right: 3px;
            }
            .gbv-figures {
              width: 100%;
              border-collapse: collapse;
            }
            .gbv-figures td {
              text-align: center;
              padding: 6px 0 16px;
              border: 0;
            }
            .gbv-figure-label {
              margin-top: 5px;
              font-size: 12px;
              font-weight: bold;
              color: #1d252b;
            }
            .gbv-figure-rule {
              margin: 6px 14px 0;
              border-top: 1.2px solid #1d252b;
            }
            .gbv-empty {
              padding: 30px 0;
              text-align: center;
              font-size: 11px;
              font-weight: bold;
              color: #6f767c;
            }
            .gbv-age {
              margin-top: 24px;
              padding-top: 16px;
              border-top: 1.3px solid #c8ced2;
              page-break-inside: avoid;
            }
            .gbv-age-layout {
              width: 100%;
              table-layout: fixed;
              border-collapse: collapse;
            }
            .gbv-age-layout > tbody > tr > td {
              vertical-align: top;
              padding: 0;
            }
            .gbv-age-title {
              text-align: center;
              font-size: 19px;
              font-weight: bold;
              letter-spacing: 0.4px;
              color: #1d252b;
            }
            .gbv-age-sub {
              margin: 4px 0 13px;
              text-align: center;
              font-size: 10.5px;
              color: #3b4248;
            }
            .gbv-tiles {
              width: 100%;
              table-layout: fixed;
              border-collapse: separate;
              border-spacing: 6px 6px;
            }
            .gbv-tiles td {
              padding: 13px 3px 15px;
              text-align: center;
              vertical-align: top;
            }
            .gbv-tiles .gbv-tile-blank {
              background: transparent;
              padding: 0;
            }
            .gbv-tile-cap {
              font-size: 9px;
              font-weight: bold;
              letter-spacing: 0.3px;
              line-height: 1.3;
              color: #2b3238;
            }
            .gbv-tile-num {
              margin: 11px 0 7px;
              font-size: 30px;
              font-weight: bold;
              line-height: 1;
              color: #1d252b;
            }
            .gbv-tile-unit {
              font-size: 9px;
              font-weight: bold;
              color: #2b3238;
            }
            .gbv-age-table {
              width: 100%;
              border-collapse: collapse;
              margin-top: 3px;
            }
            .gbv-age-table td {
              border: 1px solid #b9c0c5 !important;
              padding: 3px 4px;
              text-align: center;
              font-size: 8.5px;
              color: #3b4248;
            }
            .gbv-age-table .legend-col {
              width: 40%;
              text-align: left;
              white-space: nowrap;
            }
            .gbv-page-3 {
              page-break-before: always;
              padding-top: 4px;
            }
            .gbv-year-banner {
              width: 66%;
              margin: 8px auto 24px;
              padding: 18px 14px;
              background: #d7dbea;
              text-align: center;
              font-size: 18px;
              font-weight: bold;
              line-height: 1.45;
              color: #1d252b;
            }
            .gbv-years {
              width: 100%;
              table-layout: fixed;
              border-collapse: separate;
              border-spacing: 14px 0;
            }
            .gbv-years > tbody > tr > td {
              width: 50%;
              padding: 0;
              vertical-align: top;
              border: 0 !important;
            }
            .gbv-year-table th,
            .gbv-year-table td {
              border: 1px solid #ffffff !important;
            }
            .gbv-year-head {
              padding: 11px;
              text-align: center;
              color: #ffffff;
              font-size: 24px;
              font-weight: bold;
              letter-spacing: 0.6px;
            }
            .gbv-year-table {
              width: 100%;
              table-layout: fixed;
              border-collapse: collapse;
              margin-top: 4px;
            }
            .gbv-year-table th {
              padding: 9px 6px;
              text-align: center;
              font-size: 13px;
              font-weight: bold;
              letter-spacing: 0.2px;
              color: #ffffff;
            }
            .gbv-year-table td {
              padding: 9px 6px;
              text-align: center;
              font-size: 14px;
              font-weight: bold;
              color: #1d252b;
            }
            .gbv-year-table .no-col {
              width: 24%;
            }
            .gbv-year-table .total-col {
              width: 26%;
            }
            .gbv-year-table .name {
              text-align: left;
              padding-left: 12px;
            }
            .gbv-year-prev .gbv-year-head,
            .gbv-year-prev th {
              background: #e2413a;
            }
            .gbv-year-prev tbody tr:nth-child(odd) td {
              background: #f7d3d6;
            }
            .gbv-year-prev tbody tr:nth-child(even) td {
              background: #f2c7cb;
            }
            .gbv-year-prev tbody tr.year-total td {
              background: #fdeff1;
            }
            .gbv-year-cur .gbv-year-head {
              background: #7f7f7f;
            }
            .gbv-year-cur th {
              background: #14181b;
            }
            .gbv-year-cur tbody tr:nth-child(odd) td {
              background: #d9d9d9;
            }
            .gbv-year-cur tbody tr:nth-child(even) td {
              background: #ececec;
            }
            .gbv-year-cur tbody tr.year-total td {
              background: #ededed;
            }
            .gbv-compare {
              margin-top: 28px;
              page-break-inside: avoid;
            }
            .gbv-compare-title {
              margin-bottom: 10px;
              text-align: center;
              font-size: 24px;
              font-weight: bold;
              letter-spacing: 0.3px;
              color: #e2413a;
            }
            .gbv-compare-table {
              width: 716px;
              margin: 0 auto;
              table-layout: fixed;
              border-collapse: collapse;
            }
            .gbv-compare-table td {
              border: 1px solid #b9c0c5 !important;
              padding: 6px 3px;
              text-align: center;
              font-size: 12.5px;
              font-weight: bold;
              color: #1d252b;
            }
            .gbv-compare-table .legend-col {
              width: 8.6%;
              text-align: left;
              padding-left: 5px;
              white-space: nowrap;
              font-size: 11px;
            }
            .gbv-compare-table .region {
              font-size: 11px;
              line-height: 1.2;
              word-wrap: break-word;
            }
            .gbv-compare-table .nodata {
              font-size: 8.5px;
              color: #3b4248;
            }
          </style>

          <div class="gbv-matrix-page">
            <table class="gbv-matrix">
              <thead>
                <tr>
                  <th class="no-col">NO</th>
                  <th class="region-col">Gobolada</th>
                  <t t-foreach="block['columns']" t-as="column">
                    <th><t t-esc="column['label']"/></th>
                  </t>
                  <th class="total-col">WADARTA</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="block['rows']" t-as="row">
                  <tr>
                    <td class="no-col"><t t-esc="row['seq']"/>.</td>
                    <td class="region-col"><t t-esc="row['name']"/></td>
                    <t t-if="row['no_data']">
                      <td class="no-data" t-att-colspan="len(block['columns'])">
                        Wax xog ah kama aanu helin
                      </td>
                      <td class="total-cell">-</td>
                    </t>
                    <t t-else="">
                      <t t-foreach="row['cells']" t-as="cell">
                        <td><t t-esc="cell"/></td>
                      </t>
                      <td class="total-cell"><t t-esc="row['total']"/></td>
                    </t>
                  </tr>
                </t>
                <tr class="grand-total">
                  <td colspan="2" class="region-col">Tirada Gobolba</td>
                  <t t-foreach="block['column_totals']" t-as="column_total">
                    <td><t t-esc="column_total"/></td>
                  </t>
                  <td class="total-cell"><t t-esc="block['grand_total']"/> Kiis</td>
                </tr>
              </tbody>
            </table>

            <t t-if="block['cards']">
              <div class="gbv-card-title">
                Faahfaahinta Kiisaska ee Gobolada, Degmooyinka iyo Deegaanada.
              </div>
              <table class="gbv-cards">
                <tbody>
                  <t t-foreach="block['card_rows']" t-as="card_row">
                    <tr>
                      <t t-foreach="card_row" t-as="card">
                        <td>
                          <div class="gbv-card" t-if="card">
                            <div class="gbv-card-head" t-attf-style="background:#{card['colour']}">
                              Gobolka <t t-esc="card['region']"/>
                            </div>
                            <table>
                              <tbody>
                                <t t-foreach="card['lines']" t-as="line">
                                  <tr>
                                    <td class="seq"><t t-esc="line['seq']"/>:</td>
                                    <td><t t-esc="line['name']"/></td>
                                    <td class="count"><t t-esc="line['count']"/></td>
                                  </tr>
                                </t>
                                <tr class="card-total">
                                  <td colspan="2" t-attf-style="background:#{card['colour']}">
                                    Wadarta Guud:
                                  </td>
                                  <td class="count"><t t-esc="card['total']"/></td>
                                </tr>
                              </tbody>
                            </table>
                          </div>
                        </td>
                      </t>
                    </tr>
                  </t>
                </tbody>
              </table>
            </t>

            <!-- ============ page two: the two charts ============ -->
            <div class="gbv-page-2">
              <table class="gbv-panels">
                <tbody>
                  <tr>
                    <td>
                      <div class="gbv-banner gbv-banner-chart">
                        <t t-esc="block['chart_title']"/>
                      </div>
                      <div class="gbv-panel-body">
                        <svg class="gbv-svg" width="352" height="245"
                             t-attf-viewBox="0 0 #{block['chart']['width']} #{block['chart']['height']}"
                             xmlns="http://www.w3.org/2000/svg">
                          <t t-set="chart" t-value="block['chart']"/>
                          <!-- gridlines and the value axis -->
                          <t t-foreach="chart['ticks']" t-as="tick">
                            <line t-att-x1="chart['left']" t-att-y1="tick['y']"
                                  t-att-x2="chart['right']" t-att-y2="tick['y']"
                                  stroke="#d5dadd" stroke-width="0.8"/>
                            <text t-att-x="chart['left'] - 5" t-att-y="tick['y'] + 3"
                                  text-anchor="end" font-size="8" fill="#5c6670"
                                  font-family="DejaVu Sans, Arial, sans-serif">
                              <t t-esc="tick['label']"/>
                            </text>
                          </t>
                          <line t-att-x1="chart['left']" t-att-y1="chart['top']"
                                t-att-x2="chart['left']" t-att-y2="chart['bottom']"
                                stroke="#8f979d" stroke-width="1"/>
                          <line t-att-x1="chart['left']" t-att-y1="chart['bottom']"
                                t-att-x2="chart['right']" t-att-y2="chart['bottom']"
                                stroke="#8f979d" stroke-width="1"/>
                          <!-- one bar, or the missing-return note, per region -->
                          <t t-foreach="chart['bars']" t-as="bar">
                            <rect t-if="not bar['no_data'] and bar['height']"
                                  t-att-x="bar['x']" t-att-y="bar['y']"
                                  t-att-width="bar['width']" t-att-height="bar['height']"
                                  t-att-fill="chart['colour']"/>
                            <t t-if="bar['no_data']">
                              <text t-att-x="bar['centre']" t-att-y="chart['nodata_y']"
                                    text-anchor="middle" font-size="7.5" fill="#3b4248"
                                    font-weight="bold"
                                    font-family="DejaVu Sans, Arial, sans-serif">
                                <tspan t-att-x="bar['centre']">Xog</tspan>
                                <tspan t-att-x="bar['centre']" dy="9">kama</tspan>
                                <tspan t-att-x="bar['centre']" dy="9">helin</tspan>
                              </text>
                            </t>
                            <text t-att-x="bar['centre']" t-att-y="chart['label_y']"
                                  text-anchor="end" font-size="8" fill="#3b4248"
                                  font-family="DejaVu Sans, Arial, sans-serif"
                                  t-attf-transform="rotate(-45 #{bar['centre']} #{chart['label_y']})">
                              <t t-esc="bar['label']"/>
                            </text>
                          </t>
                        </svg>
                      </div>
                    </td>
                    <td>
                      <div class="gbv-banner gbv-banner-sex">
                        <t t-esc="block['sex_title']"/>
                      </div>
                      <div class="gbv-panel-body">
                        <t t-set="pie" t-value="block['sex']['pie']"/>
                        <table class="gbv-figures">
                          <tbody>
                            <tr>
                              <td style="width: 58%; vertical-align: top;">
                                <div class="gbv-pie-caption">Jinsiga Dhibanayaasha</div>
                                <t t-if="pie['slices']">
                                  <svg class="gbv-svg" width="190" height="190"
                                       viewBox="0 0 200 200"
                                       xmlns="http://www.w3.org/2000/svg">
                                    <circle t-if="pie['circle']"
                                            t-att-cx="pie['centre']" t-att-cy="pie['centre']"
                                            t-att-r="pie['radius']" t-att-fill="pie['circle']"/>
                                    <t t-if="not pie['circle']">
                                      <t t-foreach="pie['slices']" t-as="slice">
                                        <path t-att-d="slice['d']" t-att-fill="slice['colour']"/>
                                      </t>
                                    </t>
                                  </svg>
                                  <div class="gbv-legend">
                                    <t t-foreach="pie['slices']" t-as="slice">
                                      <span class="item">
                                        <span class="swatch"
                                              t-attf-style="background:#{slice['colour']}"/>
                                        <t t-esc="slice['label']"/>
                                      </span>
                                    </t>
                                  </div>
                                </t>
                                <div class="gbv-empty" t-else="">
                                  Xog kama aanu helin
                                </div>
                              </td>
                              <td style="width: 42%; vertical-align: top;">
                                <svg viewBox="0 0 40 64" width="26" height="42"
                                     xmlns="http://www.w3.org/2000/svg">
                                  <circle cx="20" cy="9" r="8" fill="#E08A3C"/>
                                  <path d="M20 20 C11 20 8 30 6 44 L14 44 L14 62 L26 62 L26 44 L34 44 C32 30 29 20 20 20 Z"
                                        fill="#E08A3C"/>
                                </svg>
                                <div class="gbv-figure-label">
                                  <t t-esc="block['sex']['female']"/> Haween ah
                                </div>
                                <div style="height: 14px;"/>
                                <svg viewBox="0 0 40 64" width="26" height="42"
                                     xmlns="http://www.w3.org/2000/svg">
                                  <circle cx="20" cy="9" r="8" fill="#1F6E8C"/>
                                  <path d="M12 20 L28 20 C31 20 33 22 33 26 L33 41 L28 41 L28 62 L23 62 L23 44 L17 44 L17 62 L12 62 L12 41 L7 41 L7 26 C7 22 9 20 12 20 Z"
                                        fill="#1F6E8C"/>
                                </svg>
                                <div class="gbv-figure-label">
                                  <t t-esc="block['sex']['male']"/> Wiilal ah
                                </div>
                                <div class="gbv-figure-rule"/>
                              </td>
                            </tr>
                          </tbody>
                        </table>
                      </div>
                    </td>
                  </tr>
                </tbody>
              </table>

              <!-- victim age: five tiles and the three counts -->
              <t t-set="age" t-value="block['age']"/>
              <div class="gbv-age">
                <table class="gbv-age-layout">
                  <tbody>
                    <tr>
                      <td style="width: 62%; padding-right: 14px;">
                        <div class="gbv-age-title">
                          <t t-esc="block['age_title']"/>
                        </div>
                        <div class="gbv-age-sub">
                          <t t-esc="block['age_subtitle']"/>
                        </div>
                        <table class="gbv-tiles">
                          <tbody>
                            <tr>
                              <t t-foreach="age['tiles']" t-as="tile">
                                <td t-attf-style="background:#{tile['colour']}">
                                  <div class="gbv-tile-cap">
                                    <t t-esc="tile['label']"/>
                                  </div>
                                  <div class="gbv-tile-num">
                                    <t t-esc="tile['value']"/>
                                  </div>
                                  <div class="gbv-tile-unit">
                                    <t t-esc="tile['unit']"/>
                                  </div>
                                </td>
                              </t>
                            </tr>
                          </tbody>
                        </table>
                      </td>
                      <td style="width: 38%;">
                        <t t-set="age_chart" t-value="age['chart']"/>
                        <svg class="gbv-svg" width="272" height="189"
                             t-attf-viewBox="0 0 #{age_chart['width']} #{age_chart['height']}"
                             xmlns="http://www.w3.org/2000/svg">
                          <t t-foreach="age_chart['ticks']" t-as="tick">
                            <line t-att-x1="age_chart['left']" t-att-y1="tick['y']"
                                  t-att-x2="age_chart['right']" t-att-y2="tick['y']"
                                  stroke="#d5dadd" stroke-width="0.8"/>
                            <text t-att-x="age_chart['left'] - 5" t-att-y="tick['y'] + 3"
                                  text-anchor="end" font-size="8" fill="#5c6670"
                                  font-family="DejaVu Sans, Arial, sans-serif">
                              <t t-esc="tick['label']"/>
                            </text>
                          </t>
                          <line t-att-x1="age_chart['left']" t-att-y1="age_chart['top']"
                                t-att-x2="age_chart['left']" t-att-y2="age_chart['bottom']"
                                stroke="#8f979d" stroke-width="1"/>
                          <line t-att-x1="age_chart['left']" t-att-y1="age_chart['bottom']"
                                t-att-x2="age_chart['right']" t-att-y2="age_chart['bottom']"
                                stroke="#8f979d" stroke-width="1"/>
                          <t t-foreach="age_chart['bars']" t-as="bar">
                            <rect t-if="bar['height']"
                                  t-att-x="bar['x']" t-att-y="bar['y']"
                                  t-att-width="bar['width']" t-att-height="bar['height']"
                                  t-att-fill="age_chart['colour']"/>
                          </t>
                        </svg>
                        <!-- the categories and their counts, as a table -->
                        <table class="gbv-age-table">
                          <tbody>
                            <tr>
                              <td class="legend-col"/>
                              <t t-foreach="age['columns']" t-as="column">
                                <td><t t-esc="column['label']"/></td>
                              </t>
                            </tr>
                            <tr>
                              <td class="legend-col">
                                <span class="swatch"
                                      t-attf-style="background:#{age_chart['colour']}"/>
                                <t t-esc="block['age_legend']"/>
                              </td>
                              <t t-foreach="age['columns']" t-as="column">
                                <td><t t-esc="column['value']"/></td>
                              </t>
                            </tr>
                          </tbody>
                        </table>
                        <div class="gbv-legend">
                          <span class="item">
                            <span class="swatch"
                                  t-attf-style="background:#{age_chart['colour']}"/>
                            <t t-esc="block['age_legend']"/>
                          </span>
                        </div>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <!-- perpetrators: total, apprehended, at large -->
              <t t-set="perp" t-value="block['perp']"/>
              <div class="gbv-age">
                <table class="gbv-age-layout">
                  <tbody>
                    <tr>
                      <td style="width: 62%; padding-right: 14px;">
                        <div class="gbv-age-title">
                          <t t-esc="block['perp_title']"/>
                        </div>
                        <div class="gbv-age-sub">
                          <t t-esc="block['perp_subtitle']"/>
                        </div>
                        <table class="gbv-tiles">
                          <tbody>
                            <tr>
                              <t t-foreach="perp['tiles']" t-as="tile">
                                <td t-attf-style="background:#{tile['colour']}">
                                  <div class="gbv-tile-cap">
                                    <t t-esc="tile['label']"/>
                                  </div>
                                  <div class="gbv-tile-num">
                                    <t t-esc="tile['value']"/>
                                  </div>
                                  <div class="gbv-tile-unit">
                                    <t t-esc="tile['unit']"/>
                                  </div>
                                </td>
                              </t>
                            </tr>
                            <tr>
                              <t t-foreach="perp['age_tiles']" t-as="tile">
                                <td t-attf-style="background:#{tile['colour']}">
                                  <div class="gbv-tile-cap">
                                    <t t-esc="tile['label']"/>
                                  </div>
                                  <div class="gbv-tile-num">
                                    <t t-esc="tile['value']"/>
                                  </div>
                                  <div class="gbv-tile-unit">
                                    <t t-esc="tile['unit']"/>
                                  </div>
                                </td>
                              </t>
                              <td class="gbv-tile-blank"/>
                            </tr>
                          </tbody>
                        </table>
                      </td>
                      <td style="width: 38%;">
                        <t t-set="perp_chart" t-value="perp['chart']"/>
                        <svg class="gbv-svg" width="272" height="189"
                             t-attf-viewBox="0 0 #{perp_chart['width']} #{perp_chart['height']}"
                             xmlns="http://www.w3.org/2000/svg">
                          <t t-foreach="perp_chart['ticks']" t-as="tick">
                            <line t-att-x1="perp_chart['left']" t-att-y1="tick['y']"
                                  t-att-x2="perp_chart['right']" t-att-y2="tick['y']"
                                  stroke="#d5dadd" stroke-width="0.8"/>
                            <text t-att-x="perp_chart['left'] - 5" t-att-y="tick['y'] + 3"
                                  text-anchor="end" font-size="8" fill="#5c6670"
                                  font-family="DejaVu Sans, Arial, sans-serif">
                              <t t-esc="tick['label']"/>
                            </text>
                          </t>
                          <line t-att-x1="perp_chart['left']" t-att-y1="perp_chart['top']"
                                t-att-x2="perp_chart['left']" t-att-y2="perp_chart['bottom']"
                                stroke="#8f979d" stroke-width="1"/>
                          <line t-att-x1="perp_chart['left']" t-att-y1="perp_chart['bottom']"
                                t-att-x2="perp_chart['right']" t-att-y2="perp_chart['bottom']"
                                stroke="#8f979d" stroke-width="1"/>
                          <t t-foreach="perp_chart['bars']" t-as="bar">
                            <rect t-if="bar['height']"
                                  t-att-x="bar['x']" t-att-y="bar['y']"
                                  t-att-width="bar['width']" t-att-height="bar['height']"
                                  t-att-fill="perp_chart['colour']"/>
                          </t>
                        </svg>
                        <table class="gbv-age-table">
                          <tbody>
                            <tr>
                              <td class="legend-col"/>
                              <t t-foreach="perp['columns']" t-as="column">
                                <td><t t-esc="column['label']"/></td>
                              </t>
                            </tr>
                            <tr>
                              <td class="legend-col">
                                <span class="swatch"
                                      t-attf-style="background:#{perp_chart['colour']}"/>
                                <t t-esc="block['perp_legend']"/>
                              </td>
                              <t t-foreach="perp['columns']" t-as="column">
                                <td><t t-esc="column['value']"/></td>
                              </t>
                            </tr>
                          </tbody>
                        </table>
                        <div class="gbv-legend">
                          <span class="item">
                            <span class="swatch"
                                  t-attf-style="background:#{perp_chart['colour']}"/>
                            <t t-esc="block['perp_legend']"/>
                          </span>
                        </div>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- ============ page three: this year vs last ============ -->
            <t t-if="block['compare']">
              <t t-set="compare" t-value="block['compare']"/>
              <div class="gbv-page-3">
                <div class="gbv-year-banner">
                  <t t-esc="compare['title']"/>
                </div>
                <table class="gbv-years">
                  <tbody>
                    <tr>
                      <td class="gbv-year-prev">
                        <div class="gbv-year-head">
                          <t t-esc="compare['label_previous']"/>
                        </div>
                        <table class="gbv-year-table">
                          <thead>
                            <tr>
                              <th class="no-col">NO</th>
                              <th>Gobollada</th>
                              <th class="total-col">TOTAL</th>
                            </tr>
                          </thead>
                          <tbody>
                            <t t-foreach="compare['rows']" t-as="row">
                              <tr>
                                <td class="no-col"><t t-esc="row['seq']"/>.</td>
                                <td class="name"><t t-esc="row['name']"/></td>
                                <td class="total-col"><t t-esc="row['previous']"/></td>
                              </tr>
                            </t>
                            <tr class="year-total">
                              <td colspan="2">Kiisaska Bilaha ah</td>
                              <td class="total-col">
                                <t t-esc="compare['total_previous']"/> Kiis
                              </td>
                            </tr>
                          </tbody>
                        </table>
                      </td>
                      <td class="gbv-year-cur">
                        <div class="gbv-year-head">
                          <t t-esc="compare['label_current']"/>
                        </div>
                        <table class="gbv-year-table">
                          <thead>
                            <tr>
                              <th class="no-col">NO</th>
                              <th>Gobollada</th>
                              <th class="total-col">TOTAL</th>
                            </tr>
                          </thead>
                          <tbody>
                            <t t-foreach="compare['rows']" t-as="row">
                              <tr>
                                <td class="no-col"><t t-esc="row['seq']"/>.</td>
                                <td class="name"><t t-esc="row['name']"/></td>
                                <td class="total-col">
                                  <t t-if="row['no_data']">-</t>
                                  <t t-else=""><t t-esc="row['current']"/></t>
                                </td>
                              </tr>
                            </t>
                            <tr class="year-total">
                              <td colspan="2">Kiisaska Bilaha ah</td>
                              <td class="total-col">
                                <t t-esc="compare['total_current']"/> Kiis
                              </td>
                            </tr>
                          </tbody>
                        </table>
                      </td>
                    </tr>
                  </tbody>
                </table>

                <!-- the same two years as grouped bars -->
                <t t-set="grouped" t-value="compare['grouped']"/>
                <div class="gbv-compare">
                  <div class="gbv-compare-title">
                    <t t-esc="compare['title']"/>
                  </div>
                  <svg class="gbv-svg" width="716" height="245"
                       t-attf-viewBox="0 0 #{grouped['width']} #{grouped['height']}"
                       xmlns="http://www.w3.org/2000/svg">
                    <t t-foreach="grouped['ticks']" t-as="tick">
                      <line t-att-x1="grouped['left']" t-att-y1="tick['y']"
                            t-att-x2="grouped['right']" t-att-y2="tick['y']"
                            stroke="#d5dadd" stroke-width="0.8"/>
                      <text t-att-x="grouped['left'] - 8" t-att-y="tick['y'] + 4"
                            text-anchor="end" font-size="13" fill="#3b4248"
                            font-family="DejaVu Sans, Arial, sans-serif">
                        <t t-esc="tick['label']"/>
                      </text>
                    </t>
                    <line t-att-x1="grouped['left']" t-att-y1="grouped['bottom']"
                          t-att-x2="grouped['right']" t-att-y2="grouped['bottom']"
                          stroke="#8f979d" stroke-width="1"/>
                    <t t-foreach="grouped['groups']" t-as="group">
                      <t t-foreach="group['bars']" t-as="bar">
                        <rect t-if="bar['height']"
                              t-att-x="bar['x']" t-att-y="bar['y']"
                              t-att-width="bar['width']" t-att-height="bar['height']"
                              t-att-fill="bar['colour']"/>
                      </t>
                    </t>
                  </svg>
                  <table class="gbv-compare-table">
                    <tbody>
                      <tr>
                        <td class="legend-col"/>
                        <t t-foreach="compare['rows']" t-as="row">
                          <td class="region"><t t-esc="row['name']"/></td>
                        </t>
                      </tr>
                      <tr>
                        <td class="legend-col">
                          <span class="swatch"
                                t-attf-style="background:#{grouped['previous_colour']}"/>
                          <t t-esc="compare['label_previous']"/>
                        </td>
                        <t t-foreach="compare['rows']" t-as="row">
                          <td><t t-esc="row['previous']"/></td>
                        </t>
                      </tr>
                      <tr>
                        <td class="legend-col">
                          <span class="swatch"
                                t-attf-style="background:#{grouped['current_colour']}"/>
                          <t t-esc="compare['label_current']"/>
                        </td>
                        <t t-foreach="compare['rows']" t-as="row">
                          <td>
                            <span t-if="row['no_data']" class="nodata">
                              Xog kama helin
                            </span>
                            <t t-else=""><t t-esc="row['current']"/></t>
                          </td>
                        </t>
                      </tr>
                    </tbody>
                  </table>
                  <div class="gbv-legend">
                    <span class="item">
                      <span class="swatch"
                            t-attf-style="background:#{grouped['previous_colour']}"/>
                      <t t-esc="compare['label_previous']"/>
                    </span>
                    <span class="item">
                      <span class="swatch"
                            t-attf-style="background:#{grouped['current_colour']}"/>
                      <t t-esc="compare['label_current']"/>
                    </span>
                  </div>
                </div>
              </div>
            </t>
          </div>
        </div>
      </t>
    </t>
  </t>
</template>

</odoo>
