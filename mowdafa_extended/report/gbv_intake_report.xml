<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="report_gbv_intake_document">
  <t t-call="web.html_container">
    <t t-foreach="docs" t-as="doc">
      <t t-set="o" t-value="doc"/>
      <t t-call="web.external_layout">
        <t t-set="helper" t-value="doc.env['mowdafa.pdf.helper']"/>
        <div class="page mr-page">
          <t t-call="mowdafa_extended.report_mowdafa_styles"/>
          <t t-call="mowdafa_extended.report_mowdafa_title">
            <t t-set="mr_doctype" t-value="'Client Intake Form'"/>
            <t t-set="mr_ref" t-value="doc.name"/>
            <t t-set="mr_sub" t-value="doc.client_name"/>
            <t t-set="mr_badge_lbl" t-value="'Case'"/>
            <t t-set="mr_badge" t-value="doc.case_id.name"/>
          </t>
          <p style="font-size: 9.5px; color: #526777; margin: 0 0 4px;">
            <b>Disclaimer:</b> Thank you for your interest in being a client
            of <b><t t-esc="doc.case_id.case_worker_id.institution or res_company.name"/></b>.
            This form is used to collect information about new clients for
            internal purposes only and is kept confidential.</p>

          <div class="mr-sec">Personal Information</div>
          <t t-call="mowdafa_extended.report_mowdafa_rows">
            <t t-set="mr_rows" t-value="helper.grid(doc, [
                ('Name', 'client_name'), ('Gender', 'gender'),
                ('E-Mail', 'email'), ('Phone', 'phone'),
                ('Date of Birth', 'date_of_birth')])"/>
          </t>

          <div class="mr-sec">Location</div>
          <t t-call="mowdafa_extended.report_mowdafa_rows">
            <t t-set="mr_rows" t-value="helper.grid(doc, [
                ('Country', 'country_id'), ('Region', 'region_id'),
                ('District', 'district_id')])"/>
          </t>

          <div class="mr-sec">Service Request</div>
          <t t-call="mowdafa_extended.report_mowdafa_rows">
            <t t-set="mr_rows" t-value="helper.grid(doc, [
                ('What is the reason for seeking our services?', 'service_reason'),
                ('How did you hear about us?', 'heard_about')])"/>
          </t>

          <div class="mr-keep">
            <div class="mr-sec">Signature</div>
            <t t-call="mowdafa_extended.report_mowdafa_rows">
              <t t-set="mr_rows" t-value="helper.grid(doc, [
                  ('Signature', 'sign'), ('Date', 'date'),
                  ('Signature (drawn)', 'sign_img')])"/>
            </t>
          </div>
        </div>
      </t>
    </t>
  </t>
</template>

<record id="action_report_gbv_intake" model="ir.actions.report">
  <field name="name">Client Intake Form</field>
  <field name="model">gbv.intake</field>
  <field name="report_type">qweb-pdf</field>
  <field name="report_name">mowdafa_extended.report_gbv_intake_document</field>
  <field name="report_file">mowdafa_extended.report_gbv_intake_document</field>
  <field name="print_report_name">'Client Intake Form - %s' % (object.name)</field>
  <field name="binding_model_id" ref="model_gbv_intake"/>
  <field name="binding_type">report</field>
</record>

</odoo>
