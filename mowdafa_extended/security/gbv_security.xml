<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Visible category so the group is assignable on the user form. -->
    <record id="module_category_gbv" model="ir.module.category">
        <field name="name">GBV</field>
        <field name="sequence">20</field>
    </record>

    <!-- Users allowed to close a GBV case. -->
    <record id="group_gbv_case_closure" model="res.groups">
        <field name="name">GBV Case Closure</field>
        <field name="category_id" ref="module_category_gbv"/>
    </record>

    <!-- Users allowed to unlock an active master record (case worker,
         survivor, CP case worker, CP supervisor) back to draft. -->
    <record id="group_reset_to_draft" model="res.groups">
        <field name="name">Reset to Draft (GBV &amp; Child Protection)</field>
        <field name="category_id" ref="module_category_gbv"/>
        <field name="users"
               eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
    </record>

</odoo>
