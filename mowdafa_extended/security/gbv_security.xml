<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">

        <!-- Visible category so the group is assignable on the user form. -->
        <record id="module_category_gbv" model="ir.module.category">
            <field name="name">GBV</field>
            <field name="sequence">20</field>
        </record>

        <!-- Users allowed to close a GBV case. -->
        <record id="group_gbv_case_closure" model="res.groups">
            <field name="name">GBV Case Closure</field>
            <field name="category_id" ref="module_category_gbv"/>
        </record>

        <!-- Users allowed to unlock an active master record (case worker,
             survivor, CP case worker, CP supervisor) back to draft. -->
        <record id="group_reset_to_draft" model="res.groups">
            <field name="name">Reset to Draft (GBV &amp; Child Protection)</field>
            <field name="category_id" ref="module_category_gbv"/>
            <field name="users"
                   eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
        </record>

    </data>

    <data>

        <!-- ── access levels: Caseworker < GBV Admin. Their own category
             holding only this chain, so the user form renders them as a
             single "GBV Access" selection instead of checkboxes. ── -->
        <record id="module_category_gbv_access" model="ir.module.category">
            <field name="name">GBV Access</field>
            <field name="sequence">21</field>
        </record>

        <record id="group_gbv_case_worker" model="res.groups">
            <field name="name">Caseworker</field>
            <field name="category_id" ref="module_category_gbv_access"/>
            <field name="comment">Sees only the cases, survivors and forms
                they created themselves. No Dashboard, no Reporting.</field>
        </record>
        <record id="group_gbv_manager" model="res.groups">
            <field name="name">GBV Admin</field>
            <field name="category_id" ref="module_category_gbv_access"/>
            <field name="implied_ids" eval="[(4, ref('group_gbv_case_worker'))]"/>
        </record>
        <!-- Admins keep full GBV access without a manual assignment. -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_gbv_manager'))]"/>
        </record>

        <!-- ── record rules: caseworkers see their own documents only;
             GBV Admin gets an OR-rule that opens everything back up ── -->
        <record id="rule_gbv_case_own" model="ir.rule">
            <field name="name">GBV Case: own only (caseworker)</field>
            <field name="model_id" ref="model_gbv_case"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_gbv_case_worker'))]"/>
        </record>
        <record id="rule_gbv_case_all" model="ir.rule">
            <field name="name">GBV Case: all (GBV admin)</field>
            <field name="model_id" ref="model_gbv_case"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_gbv_manager'))]"/>
        </record>

        <record id="rule_survivor_master_own" model="ir.rule">
            <field name="name">Survivor: own only (caseworker)</field>
            <field name="model_id" ref="model_survivor_master"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_gbv_case_worker'))]"/>
        </record>
        <record id="rule_survivor_master_all" model="ir.rule">
            <field name="name">Survivor: all (GBV admin)</field>
            <field name="model_id" ref="model_survivor_master"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_gbv_manager'))]"/>
        </record>

        <!-- Own record included via the employee link, so the caseworker
             default (employee_id.user_id = current user) still resolves. -->
        <record id="rule_case_worker_own" model="ir.rule">
            <field name="name">Case Worker directory: own only (caseworker)</field>
            <field name="model_id" ref="model_case_worker"/>
            <field name="domain_force">['|', ('create_uid', '=', user.id),
                ('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_gbv_case_worker'))]"/>
        </record>
        <record id="rule_case_worker_all" model="ir.rule">
            <field name="name">Case Worker directory: all (GBV admin)</field>
            <field name="model_id" ref="model_case_worker"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_gbv_manager'))]"/>
        </record>

        <record id="rule_survivor_case_own" model="ir.rule">
            <field name="name">Consent Form: own only (caseworker)</field>
            <field name="model_id" ref="model_survivor_case"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_gbv_case_worker'))]"/>
        </record>
        <record id="rule_survivor_case_all" model="ir.rule">
            <field name="name">Consent Form: all (GBV admin)</field>
            <field name="model_id" ref="model_survivor_case"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_gbv_manager'))]"/>
        </record>

        <record id="rule_admission_form_own" model="ir.rule">
            <field name="name">Admission Form: own only (caseworker)</field>
            <field name="model_id" ref="model_admission_form"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_gbv_case_worker'))]"/>
        </record>
        <record id="rule_admission_form_all" model="ir.rule">
            <field name="name">Admission Form: all (GBV admin)</field>
            <field name="model_id" ref="model_admission_form"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_gbv_manager'))]"/>
        </record>

        <record id="rule_action_plan_own" model="ir.rule">
            <field name="name">Action Plan: own only (caseworker)</field>
            <field name="model_id" ref="model_action_plan"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_gbv_case_worker'))]"/>
        </record>
        <record id="rule_action_plan_all" model="ir.rule">
            <field name="name">Action Plan: all (GBV admin)</field>
            <field name="model_id" ref="model_action_plan"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_gbv_manager'))]"/>
        </record>

        <record id="rule_followup_form_own" model="ir.rule">
            <field name="name">Follow-up Form: own only (caseworker)</field>
            <field name="model_id" ref="model_followup_form"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_gbv_case_worker'))]"/>
        </record>
        <record id="rule_followup_form_all" model="ir.rule">
            <field name="name">Follow-up Form: all (GBV admin)</field>
            <field name="model_id" ref="model_followup_form"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_gbv_manager'))]"/>
        </record>

        <record id="rule_referral_form_own" model="ir.rule">
            <field name="name">Referral Form: own only (caseworker)</field>
            <field name="model_id" ref="model_referral_form"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_gbv_case_worker'))]"/>
        </record>
        <record id="rule_referral_form_all" model="ir.rule">
            <field name="name">Referral Form: all (GBV admin)</field>
            <field name="model_id" ref="model_referral_form"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_gbv_manager'))]"/>
        </record>

        <record id="rule_case_closure_own" model="ir.rule">
            <field name="name">Case Closure: own only (caseworker)</field>
            <field name="model_id" ref="model_case_closure"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_gbv_case_worker'))]"/>
        </record>
        <record id="rule_case_closure_all" model="ir.rule">
            <field name="name">Case Closure: all (GBV admin)</field>
            <field name="model_id" ref="model_case_closure"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_gbv_manager'))]"/>
        </record>

    </data>

</odoo>
