<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cp_case_worker_tree" model="ir.ui.view">
        <field name="name">cp.case.worker.tree</field>
        <field name="model">cp.case.worker</field>
        <field name="arch" type="xml">
            <tree string="Case Workers">
                <field name="employee_id"/>
                <field name="institution"/>
                <field name="location"/>
                <field name="id_no"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'draft'"/>
            </tree>
        </field>
    </record>

    <record id="view_cp_case_worker_form" model="ir.ui.view">
        <field name="name">cp.case.worker.form</field>
        <field name="model">cp.case.worker</field>
        <field name="arch" type="xml">
            <form string="Case Worker">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_reset_draft" string="Reset to Draft"
                            type="object" invisible="state != 'active'"
                            groups="mowdafa_extended.group_reset_to_draft"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_cases" type="object"
                                class="oe_stat_button" icon="fa-folder-open"
                                invisible="case_count == 0">
                            <field name="case_count" widget="statinfo" string="Cases"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="employee_id" string="Case Worker"/>
                        <h1>
                            <field name="employee_id" placeholder="Employee"
                                   readonly="state == 'active'"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="institution"
                                   readonly="state == 'active'"/>
                            <field name="location"
                                   readonly="state == 'active'"/>
                        </group>
                        <group>
                            <field name="id_no" readonly="state == 'active'"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_cp_case_worker" model="ir.actions.act_window">
        <field name="name">Case Workers</field>
        <field name="res_model">cp.case.worker</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Supervisors -->

</odoo>
