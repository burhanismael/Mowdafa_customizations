<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="caafag_seq_cp_case_report" model="ir.sequence">
        <field name="name">CAAFAG Case Report</field>
        <field name="code">cp.caafag.case.report</field>
        <field name="prefix">CRP/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="caafag_view_cp_case_report_form" model="ir.ui.view">
        <field name="name">cp.caafag.case.report.form</field>
        <field name="model">cp.caafag.case.report</field>
        <field name="arch" type="xml">
            <form string="Case Report">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_case" type="object"
                                class="oe_stat_button" icon="fa-folder-open"
                                invisible="not case_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Case</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <p class="text-muted">Case report — in-care incident</p>
                    </div>

                    <separator string="Child Basic Info"/>
                    <group>
                        <group>
                            <field name="case_id" readonly="1"
                                   force_save="1"/>
                            <field name="child_name" string="Name of Child"/>
                            <field name="placement"/>
                        </group>
                        <group>
                            <field name="supervisor_id"/>
                            <field name="date"/>
                        </group>
                    </group>

                    <separator string="Name of Site"/>
                    <div class="o_cp_incident_choices">
                        <div class="o_cp_incident_choice">
                            <field name="site_sleep" nolabel="1"/>
                            <label for="site_sleep"/>
                        </div>
                        <div class="o_cp_incident_choice">
                            <field name="site_education" nolabel="1"/>
                            <label for="site_education"/>
                        </div>
                        <div class="o_cp_incident_choice">
                            <field name="site_eating" nolabel="1"/>
                            <label for="site_eating"/>
                        </div>
                        <div class="o_cp_incident_choice">
                            <field name="site_trip" nolabel="1"/>
                            <label for="site_trip"/>
                        </div>
                        <div class="o_cp_incident_choice">
                            <field name="site_sports" nolabel="1"/>
                            <label for="site_sports"/>
                        </div>
                        <div class="o_cp_incident_choice">
                            <field name="site_other" nolabel="1"/>
                            <label for="site_other"/>
                        </div>
                    </div>

                    <separator string="Type of Case"/>
                    <div class="o_cp_incident_choices">
                        <div class="o_cp_incident_choice">
                            <field name="type_fight_person" nolabel="1"/>
                            <label for="type_fight_person"/>
                        </div>
                        <div class="o_cp_incident_choice">
                            <field name="type_fight_supervisor" nolabel="1"/>
                            <label for="type_fight_supervisor"/>
                        </div>
                        <div class="o_cp_incident_choice">
                            <field name="type_refuse" nolabel="1"/>
                            <label for="type_refuse"/>
                        </div>
                        <div class="o_cp_incident_choice">
                            <field name="type_smoked" nolabel="1"/>
                            <label for="type_smoked"/>
                        </div>
                        <div class="o_cp_incident_choice">
                            <field name="type_injury" nolabel="1"/>
                            <label for="type_injury"/>
                        </div>
                        <div class="o_cp_incident_choice">
                            <field name="type_damage" nolabel="1"/>
                            <label for="type_damage"/>
                        </div>
                        <div class="o_cp_incident_choice">
                            <field name="type_discrimination" nolabel="1"/>
                            <label for="type_discrimination"/>
                        </div>
                        <div class="o_cp_incident_choice">
                            <field name="type_other" nolabel="1"/>
                            <label for="type_other"/>
                        </div>
                    </div>

                    <separator string="Other Child Involved"
                               groups="mowdafa_child_protection.group_cp_protection_supervisor"/>
                    <group>
                        <group groups="mowdafa_child_protection.group_cp_protection_supervisor">
                            <field name="harmed_case_id"
                                   options="{'no_create': true}"/>
                        </group>
                        <group>
                            <field name="notify_supervisor"/>
                        </group>
                    </group>

                    <separator string="Actions Taken &amp; Sign-off"/>
                    <group>
                        <field name="action_taken" widget="radio"
                               options="{'horizontal': true}"/>
                    </group>
                    <group>
                        <group>
                            <field name="sign_child" widget="signature"/>
                        </group>
                        <group>
                            <field name="sign_supervisor" widget="signature"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="caafag_view_cp_case_report_tree" model="ir.ui.view">
        <field name="name">cp.caafag.case.report.tree</field>
        <field name="model">cp.caafag.case.report</field>
        <field name="arch" type="xml">
            <tree string="Case Reports">
                <field name="name"/>
                <field name="case_id"/>
                <field name="date"/>
                <field name="action_taken"/>
            </tree>
        </field>
    </record>

</odoo>
