<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_cp_followup" model="ir.sequence">
        <field name="name">cp.followup</field>
        <field name="code">cp.followup</field>
        <field name="prefix">FUV/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="view_cp_followup_form" model="ir.ui.view">
        <field name="name">cp.followup.form</field>
        <field name="model">cp.followup</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="case_id"/>
                            <field name="visit_number"/>
                            <field name="due_date"/>
                            <field name="status"/>
                            <field name="visit_type"/>
                            <field name="child_seen"/>
                        </group>
                        <group>
                            <field name="same_caregiver"/>
                            <field name="caregiver"/>
                            <field name="in_school"/>
                            <field name="school_detail"/>
                            <field name="concerns"/>
                            <field name="visited_by"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

</odoo>
