<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_cp_followup" model="ir.sequence">
        <field name="name">cp.followup</field>
        <field name="code">cp.followup</field>
        <field name="prefix">FUV/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="view_cp_followup_form" model="ir.ui.view">
        <field name="name">cp.followup.form</field>
        <field name="model">cp.followup</field>
        <field name="arch" type="xml">
            <form string="Follow Up Form">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_case" type="object"
                                class="oe_stat_button" icon="fa-folder-open"
                                invisible="not case_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Case</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group>
                            <field name="case_id" readonly="1"/>
                            <field name="visit_type" widget="radio"/>
                        </group>
                        <group>
                            <field name="followup_period" readonly="1"/>
                            <field name="visit_number"/>
                            <field name="due_date"/>
                            <field name="status" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Section 1 — Identity of the Child"/>
                    <group>
                        <group>
                            <field name="reg_id_number" readonly="1"/>
                            <field name="child_full_name" readonly="1"/>
                            <field name="child_nickname" readonly="1"/>
                        </group>
                        <group>
                            <field name="child_sex" readonly="1"/>
                            <field name="child_dob" readonly="1"/>
                            <field name="visiting_address" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Section 2 — Outcome of Follow-up Visit"/>
                    <group>
                        <group>
                            <field name="child_seen" widget="radio"
                                   options="{'horizontal': true}"/>
                        </group>
                        <group>
                            <field name="not_seen_reason" widget="radio"
                                   invisible="child_seen != 'no'"/>
                        </group>
                    </group>

                    <separator string="Section 3 — Current Care Arrangements"/>
                    <group>
                        <group>
                            <field name="same_caregiver" widget="radio"
                                   options="{'horizontal': true}"/>
                            <field name="change_reason" widget="radio"
                                   invisible="same_caregiver != 'no'"/>
                            <div class="alert alert-warning" role="alert"
                                 invisible="change_reason != 'abuse'">
                                <strong>"Abuse &amp; Exploitation"</strong>
                                raises an immediate protection alert.
                            </div>
                            <field name="care_arrangement_type" widget="radio"
                                   invisible="same_caregiver != 'no'"/>
                        </group>
                        <group>
                            <field name="caregiver" readonly="1"/>
                            <field name="new_caregiver_name"/>
                            <field name="new_caregiver_nsd"/>
                            <field name="new_caregiver_relationship"/>
                            <field name="new_caregiver_location"/>
                            <field name="new_care_start_date"/>
                            <field name="change_circumstances"/>
                        </group>
                    </group>

                    <separator string="Section 4 — Activities"/>
                    <group>
                        <group>
                            <field name="in_school" widget="radio"
                                   options="{'horizontal': true}"/>
                            <field name="not_school_reason" widget="radio"
                                   invisible="in_school != 'no'"/>
                        </group>
                        <group>
                            <field name="education_type" widget="radio"
                                   invisible="in_school != 'yes'"/>
                            <field name="education_level"
                                   invisible="in_school != 'yes'"/>
                        </group>
                    </group>

                    <separator string="Section 5 — Protection Assessment"/>
                    <p class="text-muted">Report any protection concerns
                        (Education, PSS, Health, Nutrition, behaviour, community
                        relations). The concerns recorded at registration are
                        shown as the baseline.</p>
                    <field name="assessment_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="category"/>
                            <field name="at_registration"/>
                            <field name="immediate_action"/>
                            <field name="details"/>
                        </tree>
                    </field>

                    <separator string="Form Completed By"/>
                    <group>
                        <group>
                            <field name="completed_by" string="Name"/>
                            <field name="completed_position" string="Position"/>
                            <field name="completed_agency" string="Agency"/>
                        </group>
                        <group>
                            <field name="completed_place" string="Place"/>
                            <field name="completed_date" string="Date"/>
                            <field name="completed_location"/>
                            <field name="completed_sign" string="Signature"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

</odoo>
