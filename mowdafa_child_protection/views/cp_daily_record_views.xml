<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_cp_daily_record" model="ir.sequence">
        <field name="name">cp.daily.record</field>
        <field name="code">cp.daily.record</field>
        <field name="prefix">DAY/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="view_cp_daily_record_form" model="ir.ui.view">
        <field name="name">cp.daily.record.form</field>
        <field name="model">cp.daily.record</field>
        <field name="arch" type="xml">
            <form string="Performance and Progress Record">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_case" type="object"
                                class="oe_stat_button" icon="fa-folder-open"
                                invisible="not case_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Case</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <separator string="Child Basic Info"/>
                    <group>
                        <group>
                            <field name="case_id"/>
                            <field name="child_full_name" string="Full Name" readonly="1"/>
                            <field name="child_sex" readonly="1"/>
                            <field name="child_age" string="Age" readonly="1"/>
                        </group>
                        <group>
                            <field name="placement_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="date"/>
                            <field name="week"/>
                            <field name="month"/>
                        </group>
                    </group>

                    <separator string="Number of Hours Attended"/>
                    <group>
                        <field name="hours_attended" nolabel="1" widget="radio"
                               options="{'horizontal': true}"/>
                    </group>

                    <separator string="Number of Events Participated"/>
                    <field name="event_ids" nolabel="1"
                           class="o_cp_events_horizontal"
                           widget="many2many_checkboxes"
                           options="{'no_create_edit': True}"/>

                    <separator string="Overall Performance Rating"/>
                    <group>
                        <field name="performance_id" nolabel="1" widget="radio"
                               options="{'horizontal': true, 'no_create_edit': True}"/>
                    </group>

                    <separator string="Supervisor's Comments"/>
                    <field name="comment" nolabel="1" class="col-12"
                           placeholder="Supervisor's comments…"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

</odoo>
