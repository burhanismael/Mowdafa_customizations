<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence: CP/2026/0001 -->
    <record id="caafag_seq_cp_case" model="ir.sequence">
        <field name="name">CAAFAG Case</field>
        <field name="code">cp.caafag.case</field>
        <field name="prefix">CFG/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Form -->
    <record id="caafag_view_cp_case_form" model="ir.ui.view">
        <field name="name">cp.caafag.case.form</field>
        <field name="model">cp.caafag.case</field>
        <field name="arch" type="xml">
            <form string="Child Protection Case">
                <header>
                    <field name="adult_verified" invisible="1"/>
                    <field name="child_verified" invisible="1"/>
                    <field name="verification_conflict" invisible="1"/>
                    <button name="action_create_handover" type="object"
                        string="Create Hand-over" class="btn-primary"
                        invisible="stage != 'handover' or handover_count &gt; 0"/>
                    <button name="action_create_registration" type="object"
                        string="Create Registration" class="btn-primary"
                        invisible="stage != 'registration' or registration_count &gt; 0"/>
                    <button name="action_create_child_info" type="object"
                        string="Child Information" class="btn-primary"
                        invisible="stage not in ('verification', 'in_care') or child_info_count &gt; 0"/>
                    <button name="action_create_psychosocial" type="object"
                        string="Create Psychosocial"
                        invisible="stage != 'in_care'"/>
                    <button name="action_create_daily_record" type="object"
                        string="Create Performance Record"
                        invisible="stage != 'in_care'"/>
                    <button name="action_create_mentoring" type="object"
                        string="Create Mentoring Report"
                        invisible="stage != 'in_care'"/>
                    <button name="action_create_case_report" type="object"
                        string="Create Case Report"
                        invisible="stage != 'in_care'"/>
                    <button name="action_create_reunification" type="object"
                        string="Create Reunification" class="btn-primary"
                        invisible="stage != 'in_care' or reunification_count &gt; 0"/>
                    <button name="action_create_followup_visit" type="object"
                        string="New Follow-up Visit" class="btn-primary"
                        invisible="stage not in ('reunification', 'followup')"/>
                    <field name="stage" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_documents" type="object"
                                class="oe_stat_button" icon="fa-paperclip">
                            <field name="attachment_count" widget="statinfo"
                                   string="Documents"/>
                        </button>
                        <button name="action_view_handovers" type="object"
                                class="oe_stat_button" icon="fa-exchange"
                                invisible="handover_count == 0">
                            <field name="handover_count" widget="statinfo" string="Hand-over"/>
                        </button>
                        <button name="action_view_registrations" type="object"
                                class="oe_stat_button" icon="fa-id-card-o"
                                invisible="registration_count == 0">
                            <field name="registration_count" widget="statinfo" string="Registration"/>
                        </button>
                        <button name="action_view_placements" type="object"
                                class="oe_stat_button" icon="fa-home"
                                invisible="placement_count == 0">
                            <field name="placement_count" widget="statinfo" string="Placements"/>
                        </button>
                        <button name="action_view_psychosocial" type="object"
                                class="oe_stat_button" icon="fa-heart-o"
                                invisible="psychosocial_count == 0">
                            <field name="psychosocial_count" widget="statinfo" string="Psychosocial"/>
                        </button>
                        <button name="action_view_daily_records" type="object"
                                class="oe_stat_button" icon="fa-line-chart"
                                invisible="daily_record_count == 0">
                            <field name="daily_record_count" widget="statinfo" string="Performance"/>
                        </button>
                        <button name="action_view_mentoring" type="object"
                                class="oe_stat_button" icon="fa-users"
                                invisible="mentoring_count == 0">
                            <field name="mentoring_count" widget="statinfo" string="Mentoring"/>
                        </button>
                        <button name="action_view_case_reports" type="object"
                                class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="case_report_count == 0">
                            <field name="case_report_count" widget="statinfo" string="Case Reports"/>
                        </button>
                        <button name="action_view_child_info" type="object"
                                class="oe_stat_button" icon="fa-id-badge"
                                invisible="child_info_count == 0">
                            <field name="child_info_count" widget="statinfo" string="Child Info"/>
                        </button>
                        <button name="action_view_reunifications" type="object"
                                class="oe_stat_button" icon="fa-handshake-o"
                                invisible="reunification_count == 0">
                            <field name="reunification_count" widget="statinfo" string="Reunification"/>
                        </button>
                        <button name="action_view_followup_visits" type="object"
                                class="oe_stat_button" icon="fa-calendar-check-o"
                                invisible="followup_visit_count == 0">
                            <field name="followup_visit_count" widget="statinfo" string="Follow-ups"/>
                        </button>
                    </div>
                    <field name="photo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group string="1 · Child Identification">
                        <group>
                            <field name="case_type" invisible="1"/>
                            <field name="first_name"/>
                            <field name="middle_name"/>
                            <field name="last_name"/>
                            <field name="other_names"/>
                            <field name="child_name" readonly="1"/>
                            <field name="nickname"/>
                        </group>
                        <group>
                            <field name="sex"/>
                            <field name="date_of_birth"/>
                            <field name="dob_estimated"/>
                            <field name="age_years"/>
                            <field name="nationality_id" options="{'no_create': true}"/>
                            <field name="population_group"/>
                            <field name="disability"/>
                        </group>
                    </group>
                    <group string="Location — for the report">
                        <group>
                            <field name="country_id" options="{'no_create_edit': True}"/>
                            <field name="region_id" options="{'no_create_edit': True}"/>
                            <field name="district_id" options="{'no_create_edit': True}"/>
                            <field name="village"/>
                        </group>
                        <group>
                            <field name="camp"/>
                            <field name="date_identified"/>
                            <field name="referral_source_id" options="{'no_create': true}"/>
                        </group>
                    </group>
                    <group>
                        <group string="Protection Concern">
                            <field name="protection_concern_id"/>
                            <field name="concern_description"/>
                        </group>
                        <group string="Safety &amp; Risk">
                            <field name="risk_level"/>
                            <field name="immediate_risk"/>
                            <field name="risk_factors"/>
                        </group>
                    </group>
                    <group string="Case Management — MOWDAFA">
                        <group>
                            <field name="case_worker_id" options="{'no_create_edit': True}"/>
                            <field name="supervisor_id" options="{'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="placement_type"/>
                            <field name="recommendation"/>
                        </group>
                    </group>
                    <group string="Verification Gate">
                        <group>
                            <field name="verification_conflict"
                                   invisible="not verification_conflict"/>
                            <field name="supervisor_decision"
                                   invisible="not verification_conflict and not supervisor_decision"/>
                            <field name="supervisor_reason"
                                   invisible="not verification_conflict and not supervisor_decision"
                                   required="supervisor_decision != False"/>
                        </group>
                    </group>
                    <separator string="Notes"/>
                    <field name="notes" nolabel="1" placeholder="Case notes…"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- List -->
    <record id="caafag_view_cp_case_tree" model="ir.ui.view">
        <field name="name">cp.caafag.case.tree</field>
        <field name="model">cp.caafag.case</field>
        <field name="arch" type="xml">
            <tree string="Child Protection Cases">
                <field name="name"/>
                <field name="child_name" string="Child"/>
                <field name="sex" optional="hide"/>
                <field name="age_years" optional="hide"/>
                <field name="region_id"/>
                <field name="district_id" optional="show"/>
                <field name="protection_concern_id"/>
                <field name="risk_level" widget="badge"
                       decoration-danger="risk_level in ('critical', 'high')"
                       decoration-warning="risk_level == 'moderate'"
                       decoration-success="risk_level == 'low'"/>
                <field name="stage" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- Care pipeline: stage accents and labelled risk/recommendation tags. -->
    <record id="caafag_view_cp_case_kanban" model="ir.ui.view">
        <field name="name">cp.caafag.case.kanban</field>
        <field name="model">cp.caafag.case</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage" quick_create="false"
                    class="o_cp_case_compact_kanban">
                <field name="name"/>
                <field name="stage"/>
                <field name="risk_level"/>
                <field name="recommendation"/>
                <field name="child_name"/>
                <field name="sex"/>
                <field name="age_years"/>
                <field name="district_id"/>
                <field name="case_worker_id"/>
                <field name="immediate_risk"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click cp-case-card cp-stage-{{ record.stage.raw_value }}">
                            <div class="cp-card-heading">
                                <span class="cp-case-reference"><field name="name"/></span>
                                <span t-if="record.risk_level.raw_value"
                                      t-attf-class="cp-tag cp-risk-{{ record.risk_level.raw_value }}">
                                    <i class="fa fa-flag" aria-hidden="true"/>
                                    <field name="risk_level"/> risk
                                </span>
                            </div>
                            <div class="cp-child-name">
                                <field t-if="record.child_name.value" name="child_name"/>
                                <span t-else="" class="text-muted">Not yet named</span>
                            </div>
                            <div t-if="record.sex.raw_value || record.age_years.raw_value" class="cp-card-detail">
                                <i class="fa fa-user-o" aria-hidden="true"/>
                                <field t-if="record.sex.raw_value" name="sex"/>
                                <span t-if="record.sex.raw_value &amp;&amp; record.age_years.raw_value" aria-hidden="true">·</span>
                                <span t-if="record.age_years.raw_value"><field name="age_years"/> years</span>
                            </div>
                            <div t-if="record.district_id.raw_value" class="cp-card-detail">
                                <i class="fa fa-map-marker" aria-hidden="true"/>
                                <field name="district_id"/>
                            </div>
                            <div class="cp-card-tags">
                                <span class="cp-tag cp-stage-tag"><field name="stage"/></span>
                                <span t-if="record.recommendation.raw_value"
                                      t-attf-class="cp-tag cp-recommendation-{{ record.recommendation.raw_value }}">
                                    <field name="recommendation"/>
                                </span>
                                <span t-if="record.immediate_risk.raw_value" class="cp-tag cp-risk-critical">
                                    <i class="fa fa-exclamation-triangle" aria-hidden="true"/> Immediate risk
                                </span>
                            </div>
                            <div class="cp-card-footer">
                                <span class="cp-worker-icon"><i class="fa fa-user" aria-hidden="true"/></span>
                                <span class="cp-worker-name" title="Case worker">
                                    <field t-if="record.case_worker_id.raw_value" name="case_worker_id"/>
                                    <span t-else="" class="text-muted">Unassigned</span>
                                </span>
                                <i class="fa fa-angle-right cp-open-icon" aria-hidden="true"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search -->
    <record id="caafag_view_cp_case_search" model="ir.ui.view">
        <field name="name">cp.caafag.case.search</field>
        <field name="model">cp.caafag.case</field>
        <field name="arch" type="xml">
            <search string="CAAFAG Cases">
                <field name="name"/>
                <field name="child_name"/>
                <filter string="Critical / High Risk" name="high_risk"
                        domain="[('risk_level', 'in', ('critical', 'high'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Stage" name="group_stage"
                            context="{'group_by': 'stage'}"/>
                    <filter string="Region" name="group_region"
                            context="{'group_by': 'region_id'}"/>
                    <filter string="Concern" name="group_concern"
                            context="{'group_by': 'protection_concern_id'}"/>
                    <filter string="Risk Level" name="group_risk"
                            context="{'group_by': 'risk_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <!-- Action -->
    <record id="caafag_action_cp_case" model="ir.actions.act_window">
        <field name="name">CAAFAG</field>
        <field name="res_model">cp.caafag.case</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="caafag_view_cp_case_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Open a CAAFAG file</p>
            <p>Children formerly associated with armed forces and groups
               — the full journey from hand-over to reunification, in its
               own register.</p>
        </field>
    </record>


    <menuitem id="menu_cp_case_caafag" name="CAAFAG"
              parent="menu_cp_case_managed" action="caafag_action_cp_case"
              sequence="20" groups="group_cp_caafag"/>
</odoo>
