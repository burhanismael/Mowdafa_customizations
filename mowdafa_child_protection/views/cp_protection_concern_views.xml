<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cp_protection_concern_tree" model="ir.ui.view">
        <field name="name">cp.protection.concern.tree</field>
        <field name="model">cp.protection.concern</field>
        <field name="arch" type="xml">
