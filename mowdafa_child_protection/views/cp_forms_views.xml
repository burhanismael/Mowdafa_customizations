<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_cp_placement" model="ir.sequence">
        <field name="name">cp.placement</field>
        <field name="code">cp.placement</field>
        <field name="prefix">PLC/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="view_cp_placement_form" model="ir.ui.view">
        <field name="name">cp.placement.form</field>
        <field name="model">cp.placement</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="case_id"/>
                            <field name="type"/>
                            <field name="requires_daily"/>
                            <field name="date_start"/>
                        </group>
                        <group>
                            <field name="date_end"/>
                            <field name="location"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="seq_cp_handover" model="ir.sequence">
        <field name="name">cp.handover</field>
        <field name="code">cp.handover</field>
        <field name="prefix">HOV/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="view_cp_handover_form" model="ir.ui.view">
        <field name="name">cp.handover.form</field>
        <field name="model">cp.handover</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="case_id"/>
                            <field name="handover_datetime"/>
                            <field name="by_organisation"/>
                            <field name="by_name"/>
                            <field name="by_position"/>
                            <field name="by_location"/>
                            <field name="by_contact" string="Contact"/>
                            <field name="to_institution"/>
                            <field name="received_by"/>
                        </group>
                        <group>
                            <field name="received_role"/>
                            <field name="received_contact" string="Contact"/>
                            <field name="received_address"/>
                            <field name="sign_handing_over"/>
                            <field name="sign_child"/>
                            <field name="sign_receiver"/>
                            <field name="sign_witness"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="seq_cp_registration" model="ir.sequence">
        <field name="name">cp.registration</field>
        <field name="code">cp.registration</field>
        <field name="prefix">REG/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="view_cp_registration_form" model="ir.ui.view">
        <field name="name">cp.registration.form</field>
        <field name="model">cp.registration</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="case_id"/>
                            <field name="date"/>
                            <field name="place"/>
                            <field name="date_of_arrival"/>
                            <field name="registered_by"/>
                            <field name="consent_registration"/>
                            <field name="consent_registration_by"/>
                            <field name="consent_data"/>
                            <field name="consent_data_limits"/>
                            <field name="child_assent"/>
                            <field name="nickname"/>
                            <field name="father_name"/>
                            <field name="mother_name"/>
                            <field name="other_relative"/>
                        </group>
                        <group>
                            <field name="place_of_origin"/>
                            <field name="current_address"/>
                            <field name="schooling_history"/>
                            <field name="literacy"/>
                            <field name="wants_to_learn"/>
                            <field name="found_at"/>
                            <field name="referred_by"/>
                            <field name="care_before"/>
                            <field name="care_now"/>
                            <field name="immediate_actions"/>
                            <field name="withhold"/>
                            <field name="withhold_what"/>
                            <field name="withhold_from"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="seq_cp_verification" model="ir.sequence">
        <field name="name">cp.verification</field>
        <field name="code">cp.verification</field>
        <field name="prefix">VER/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="view_cp_verification_form" model="ir.ui.view">
        <field name="name">cp.verification.form</field>
        <field name="model">cp.verification</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="case_id"/>
                            <field name="kind"/>
                            <field name="interview_date"/>
                            <field name="interview_place"/>
                            <field name="interviewed_alone"/>
                            <field name="adult_name"/>
                            <field name="adult_relationship"/>
                            <field name="adult_contact"/>
                        </group>
                        <group>
                            <field name="adult_address"/>
                            <field name="photo_recognised"/>
                            <field name="account"/>
                            <field name="accounts_match"/>
                            <field name="child_wishes"/>
                            <field name="recommendation"/>
                            <field name="reasons"/>
                            <field name="completed_by"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="seq_cp_daily_record" model="ir.sequence">
        <field name="name">cp.daily.record</field>
        <field name="code">cp.daily.record</field>
        <field name="prefix">DAY/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="view_cp_daily_record_form" model="ir.ui.view">
        <field name="name">cp.daily.record.form</field>
        <field name="model">cp.daily.record</field>
        <field name="arch" type="xml">
            <form string="Performance and Progress Record">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group string="Child Basic Info">
                        <group>
                            <field name="case_id"/>
                            <field name="hours_attended"/>
                            <field name="performance_id"
                                   options="{'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="week"/>
                            <field name="month"/>
                        </group>
                    </group>
                    <group string="Number of Events Participated">
                        <field name="event_ids" nolabel="1"
                               class="o_cp_events_horizontal"
                               widget="many2many_checkboxes"
                               options="{'no_create_edit': True}"/>
                    </group>
                    <separator string="Supervisor's Comments"/>
                    <field name="comment" nolabel="1" class="col-12"
                           placeholder="Supervisor's comments…"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="seq_cp_mentoring" model="ir.sequence">
        <field name="name">cp.mentoring</field>
        <field name="code">cp.mentoring</field>
        <field name="prefix">MEN/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="view_cp_mentoring_form" model="ir.ui.view">
        <field name="name">cp.mentoring.form</field>
        <field name="model">cp.mentoring</field>
        <field name="arch" type="xml">
            <form string="Mentoring Activity Report">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group string="Report Details">
                        <group>
                            <field name="case_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="mentor"/>
                            <field name="mentor_phone"/>
                        </group>
                    </group>

                    <separator string="1 · Weekly Activities"/>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="activity"/>
                            <field name="week_1"/>
                            <field name="week_2"/>
                            <field name="week_3"/>
                            <field name="week_4"/>
                            <field name="week_5"/>
                        </tree>
                    </field>
                    <group>
                        <field name="total_hours" widget="radio"
                               options="{'horizontal': true}"/>
                    </group>

                    <separator string="2 · Activities This Month (check all that apply)"/>
                    <group>
                        <group>
                            <field name="act_study_circles"/>
                            <field name="act_sports"/>
                            <field name="act_field_trips"/>
                            <field name="act_watching_videos"/>
                        </group>
                        <group>
                            <field name="act_goal_setting"/>
                            <field name="act_pss"/>
                            <field name="act_social"/>
                            <field name="act_other"/>
                            <field name="act_other_text" string="Other"
                                   invisible="not act_other"/>
                        </group>
                    </group>

                    <separator string="3 · Mentee's Motivation This Month"/>
                    <p class="text-muted">Check the box that best describes your
                        mentee's motivation in each area this month.</p>
                    <field name="motivation_ids">
                        <tree editable="bottom" create="false" delete="false">
                            <field name="sequence" widget="handle"/>
                            <field name="area" readonly="1" force_save="1"/>
                            <field name="increased"/>
                            <field name="no_change"/>
                            <field name="decreased"/>
                        </tree>
                    </field>

                    <separator string="4 · Major Obstacles"/>
                    <field name="obstacles" nolabel="1" class="col-12"
                           placeholder="Describe any major obstacles and how they were handled…"/>
                    <separator string="5 · Additional Comments"/>
                    <field name="additional_comments" nolabel="1" class="col-12"
                           placeholder="Comments, suggestions or questions for staff…"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="seq_cp_psychosocial" model="ir.sequence">
        <field name="name">cp.psychosocial</field>
        <field name="code">cp.psychosocial</field>
        <field name="prefix">PSS/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="view_cp_psychosocial_form" model="ir.ui.view">
        <field name="name">cp.psychosocial.form</field>
        <field name="model">cp.psychosocial</field>
        <field name="arch" type="xml">
            <form string="Psychosocial Support Form">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group string="Person Details">
                        <group>
                            <field name="case_id"/>
                            <field name="person_name"/>
                            <field name="gender"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="age"/>
                            <field name="class_group"/>
                        </group>
                    </group>

                    <separator string="Health &amp; Wellbeing"/>
                    <group>
                        <label for="existing_illness"
                               string="Does the Person have an existing illness?"/>
                        <div>
                            <field name="existing_illness" widget="boolean_toggle"/>
                        </div>
                    </group>
                    <field name="existing_illness_desc" nolabel="1" class="col-12"
                           placeholder="If YES, describe below…"
                           invisible="not existing_illness"/>

                    <group>
                        <label for="previous_illness"
                               string="Has the Person had a previous serious illness or injury?"/>
                        <div>
                            <field name="previous_illness" widget="boolean_toggle"/>
                        </div>
                    </group>
                    <field name="previous_illness_desc" nolabel="1" class="col-12"
                           placeholder="If YES, describe below…"
                           invisible="not previous_illness"/>

                    <group>
                        <label for="special_fears"
                               string="Does the Person have any special fears?"/>
                        <div>
                            <field name="special_fears" widget="boolean_toggle"/>
                        </div>
                    </group>
                    <field name="special_fears_desc" nolabel="1" class="col-12"
                           placeholder="If YES, describe below…"
                           invisible="not special_fears"/>

                    <group>
                        <label for="psychosocial_problems"
                               string="Does the Person have Psychosocial Problems?"/>
                        <div>
                            <field name="psychosocial_problems" widget="boolean_toggle"/>
                        </div>
                    </group>
                    <field name="psychosocial_problems_desc" nolabel="1" class="col-12"
                           placeholder="If YES, describe below…"
                           invisible="not psychosocial_problems"/>

                    <separator string="Play &amp; Family"/>
                    <label for="play_with_others"
                           string="What activities does the Person like to do when playing with other Persons?"/>
                    <field name="play_with_others" nolabel="1" class="col-12"
                           placeholder="Activities with others…"/>
                    <label for="play_alone"
                           string="What does the Person like to do when playing alone?"/>
                    <field name="play_alone" nolabel="1" class="col-12"
                           placeholder="Activities alone…"/>
                    <label for="family_description"
                           string="Family of the Person (parents, siblings, grandparents and other extended family)"/>
                    <field name="family_description" nolabel="1" class="col-12"
                           placeholder="Describe the family…"/>

                    <separator string="Advice &amp; Action"/>
                    <label for="additional_comments" string="Additional Comments"/>
                    <field name="additional_comments" nolabel="1" class="col-12"
                           placeholder="Additional comments…"/>
                    <label for="services_provided"
                           string="Services you provide (area you advise)"/>
                    <field name="services_provided" nolabel="1" class="col-12"
                           placeholder="Services provided…"/>
                    <label for="action_points" string="Action Points (agreed points)"/>
                    <field name="action_points" nolabel="1" class="col-12"
                           placeholder="Action points…"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

