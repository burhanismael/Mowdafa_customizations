<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cp_grade_level_tree" model="ir.ui.view">
        <field name="name">cp.grade.level.tree</field>
        <field name="model">cp.grade.level</field>
        <field name="arch" type="xml">
            <tree string="Grade Levels" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="action_cp_grade_level" model="ir.actions.act_window">
        <field name="name">Grade Levels</field>
        <field name="res_model">cp.grade.level</field>
        <field name="view_mode">tree</field>
    </record>

    <data noupdate="1">

    <record id="grade_early_childhood" model="cp.grade.level">
        <field name="name">Early childhood</field><field name="sequence">10</field>
    </record>

    <record id="grade_primary" model="cp.grade.level">
        <field name="name">Primary</field><field name="sequence">20</field>
    </record>

    <record id="grade_secondary" model="cp.grade.level">
        <field name="name">Secondary</field><field name="sequence">30</field>
    </record>

    <record id="grade_non_formal" model="cp.grade.level">
        <field name="name">Non-formal</field><field name="sequence">40</field>
    </record>

    <record id="grade_adult_education" model="cp.grade.level">
        <field name="name">Adult education / literacy</field><field name="sequence">50</field>
    </record>

    <record id="grade_vocational" model="cp.grade.level">
        <field name="name">Vocational training</field><field name="sequence">60</field>
    </record>

    <record id="grade_accelerated" model="cp.grade.level">
        <field name="name">Accelerated training</field><field name="sequence">70</field>
    </record>

    <record id="grade_other" model="cp.grade.level">
        <field name="name">Other</field><field name="sequence">80</field>
    </record>

    </data>

</odoo>
