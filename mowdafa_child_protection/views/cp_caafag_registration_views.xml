<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="caafag_seq_cp_registration" model="ir.sequence">
    <field name="name">cp.caafag.registration</field>
    <field name="code">cp.caafag.registration</field>
    <field name="prefix">CREG/%(year)s/</field>
    <field name="padding">4</field>
    <field name="company_id" eval="False"/>
  </record>

  <!-- CAAFAG Centre Registration Form — the short enrolment form filled
       when the child enters the centre. The full intake (profile,
       location & care, protection, confidentiality) is Child
       Information, the next step. -->
  <record id="caafag_view_cp_registration_form" model="ir.ui.view">
    <field name="name">cp.caafag.registration.form</field>
    <field name="model">cp.caafag.registration</field>
    <field name="arch" type="xml">
      <form string="Centre Registration Form" class="o_cp_registration_form">
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_case" type="object" class="oe_stat_button"
                    icon="fa-folder-open" invisible="not case_id">
              <div class="o_stat_info">
                <span class="o_stat_text">Case</span>
              </div>
            </button>
          </div>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
            <div class="text-muted">
              <field name="centre" readonly="1" class="oe_inline"/>
              <span> · Registration Form · </span>
              <field name="batch_id" readonly="1" class="oe_inline"
                     options="{'no_open': true}"/>
            </div>
          </div>

          <separator string="Participant Profile"/>
          <group>
            <group>
              <field name="case_id" readonly="1" force_save="1"/>
              <field name="child_full_name" string="Name" readonly="1"/>
              <field name="child_sex" string="Gender" widget="radio"
                     options="{'horizontal': true}" readonly="1"/>
              <field name="age_years" string="Age"/>
              <field name="date" string="Date of registration"
                     readonly="1" force_save="1"/>
            </group>
            <group>
              <field name="centre" string="Center"/>
              <field name="batch_id" options="{'no_create': true}"/>
              <field name="entry_month" string="Entry Month / Year"
                     placeholder="09 / 2026"/>
              <field name="education_level" string="Education level"
                     placeholder="Primary — grade 4"/>
              <field name="highest_grade_id" string="Highest grade completed"
                     options="{'no_create': true}"/>
              <field name="skill_ids" string="Vocational skill"
                     widget="many2many_tags" options="{'no_create': true}"/>
              <field name="skill_certified"/>
            </group>
          </group>

          <separator string="Address &amp; Contact"/>
          <group>
            <group>
              <field name="city"/>
              <field name="region_id" string="State / Province"
                     options="{'no_create': true}"/>
            </group>
            <group>
              <field name="country_id" options="{'no_create': true}"/>
              <field name="household_tel" string="Telephone"/>
            </group>
          </group>

          <separator string="Parents &amp; Emergency Contact"/>
          <group>
            <group>
              <field name="mother_name" string="Mother's name"/>
              <field name="mother_tel" string="Mother's phone"/>
              <field name="emergency_contact" string="Emergency contact"
                     placeholder="Aunt — 0634 000 000"/>
            </group>
            <group>
              <field name="father_name" string="Father's name"/>
              <field name="father_tel" string="Father's phone"/>
            </group>
          </group>

          <separator string="🔒 Health"
                     groups="mowdafa_child_protection.group_cp_protection_supervisor"/>
          <group groups="mowdafa_child_protection.group_cp_protection_supervisor">
            <group>
              <field name="health_problems" placeholder="specify"/>
            </group>
            <group>
              <field name="on_medication" widget="radio"
                     options="{'horizontal': true}"/>
            </group>
          </group>

          <separator string="Parent Authorisation"/>
          <div class="alert alert-light border mb-3" role="note">
            <b>Emergency medical treatment.</b> "You have our permission, in
            the event of an emergency and in case we are unavailable, to
            authorize any physician, nurse practitioner or medical personnel
            to examine, interview, test and if necessary, treat my child."
          </div>
          <group>
            <group>
              <field name="emergency_treatment_auth"
                     string="Authorisation given"/>
              <field name="parent_sign_img" widget="signature"/>
              <field name="parent_sign_date"/>
            </group>
            <group>
              <field name="social_worker_id" options="{'no_create': true}"/>
              <field name="social_worker_sign_img" widget="signature"/>
              <field name="social_worker_sign_date"/>
            </group>
          </group>

          <separator string="Centre Information"/>
          <field name="centre_info" nolabel="1"
                 placeholder="Visit times, contact person, phone…"/>
        </sheet>
        <div class="oe_chatter">
          <field name="message_follower_ids"/>
          <field name="activity_ids"/>
          <field name="message_ids"/>
        </div>
      </form>
    </field>
  </record>
</odoo>
