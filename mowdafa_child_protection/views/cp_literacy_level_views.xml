<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cp_literacy_level_tree" model="ir.ui.view">
        <field name="name">cp.literacy.level.tree</field>
        <field name="model">cp.literacy.level</field>
        <field name="arch" type="xml">
            <tree string="Literacy Levels" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="action_cp_literacy_level" model="ir.actions.act_window">
        <field name="name">Literacy Levels</field>
        <field name="res_model">cp.literacy.level</field>
        <field name="view_mode">tree</field>
    </record>

    <data noupdate="1">

        <record id="literacy_reads" model="cp.literacy.level">
            <field name="name">Reads</field><field name="sequence">10</field>
        </record>

        <record id="literacy_writes" model="cp.literacy.level">
            <field name="name">Writes</field><field name="sequence">20</field>
        </record>

        <record id="literacy_neither" model="cp.literacy.level">
            <field name="name">Neither</field><field name="sequence">30</field>
        </record>

    </data>

</odoo>
