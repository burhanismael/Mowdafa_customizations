<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cp_partner_agency_tree" model="ir.ui.view">
        <field name="name">cp.partner.agency.tree</field>
        <field name="model">cp.partner.agency</field>
        <field name="arch" type="xml">
            <tree string="Partner Agencies">
                <field name="name"/>
                <field name="short_name"/>
                <field name="code" optional="hide"/>
                <field name="sector"/>
                <field name="focal_point_id"/>
                <field name="supervisor_id"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="view_cp_partner_agency_form" model="ir.ui.view">
        <field name="name">cp.partner.agency.form</field>
        <field name="model">cp.partner.agency</field>
        <field name="arch" type="xml">
            <form string="Partner Agency">
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" string="Agency"/>
                        <h1><field name="name" placeholder="e.g. UNICEF — Child Protection sub-cluster"/></h1>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="short_name"
                                   placeholder="e.g. UNICEF"/>
                            <field name="code"/>
                            <field name="sector"/>
                        </group>
                        <group string="Contacts — filled onto new records">
                            <field name="focal_point_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="supervisor_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_cp_partner_agency" model="ir.actions.act_window">
        <field name="name">Partner Agencies</field>
        <field name="res_model">cp.partner.agency</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the first agency</p>
            <p>The agencies whose children MOWDAFA holds records for —
               the partner report breaks down by this list.</p>
        </field>
    </record>

    <!-- Basic needs master (section 6 of the partner form) -->
    <record id="view_cp_basic_need_tree" model="ir.ui.view">
        <field name="name">cp.basic.need.tree</field>
        <field name="model">cp.basic.need</field>
        <field name="arch" type="xml">
            <tree string="Basic Needs" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="action_cp_basic_need" model="ir.actions.act_window">
        <field name="name">Basic Needs</field>
        <field name="res_model">cp.basic.need</field>
        <field name="view_mode">tree</field>
    </record>

    <!-- seed: the values the partner form offers -->
    <record id="basic_need_food" model="cp.basic.need">
        <field name="name">Food</field><field name="sequence">10</field>
    </record>
    <record id="basic_need_education" model="cp.basic.need">
        <field name="name">Education</field><field name="sequence">20</field>
    </record>
    <record id="basic_need_pss" model="cp.basic.need">
        <field name="name">Psychosocial Support</field><field name="sequence">30</field>
    </record>
    <record id="basic_need_health" model="cp.basic.need">
        <field name="name">Health Care</field><field name="sequence">40</field>
    </record>
    <record id="basic_need_legal" model="cp.basic.need">
        <field name="name">Legal Support</field><field name="sequence">50</field>
    </record>
    <record id="basic_need_shelter" model="cp.basic.need">
        <field name="name">Shelter</field><field name="sequence">60</field>
    </record>
    <record id="basic_need_other" model="cp.basic.need">
        <field name="name">Other</field><field name="sequence">70</field>
    </record>

    <!-- Event types (Number of Events Participated) -->
    <record id="view_cp_event_type_tree" model="ir.ui.view">
        <field name="name">cp.event.type.tree</field>
        <field name="model">cp.event.type</field>
        <field name="arch" type="xml">
            <tree string="Event Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="action_cp_event_type" model="ir.actions.act_window">
        <field name="name">Event Types</field>
        <field name="res_model">cp.event.type</field>
        <field name="view_mode">tree</field>
    </record>

    <record id="event_sports" model="cp.event.type">
        <field name="name">Sports</field><field name="sequence">10</field>
    </record>
    <record id="event_trip" model="cp.event.type">
        <field name="name">Trip or tourism</field><field name="sequence">20</field>
    </record>
    <record id="event_comp_learning" model="cp.event.type">
        <field name="name">Competitive learning session</field><field name="sequence">30</field>
    </record>
    <record id="event_competitions" model="cp.event.type">
        <field name="name">Competitions</field><field name="sequence">40</field>
    </record>
    <record id="event_lsbe" model="cp.event.type">
        <field name="name">LSBE Sessions</field><field name="sequence">50</field>
    </record>
    <record id="event_study_circles" model="cp.event.type">
        <field name="name">Study circles sessions</field><field name="sequence">60</field>
    </record>
    <record id="event_mentorship" model="cp.event.type">
        <field name="name">Mentorship Club</field><field name="sequence">70</field>
    </record>
    <record id="event_nfe" model="cp.event.type">
        <field name="name">NFE Sessions</field><field name="sequence">80</field>
    </record>
    <record id="event_skill" model="cp.event.type">
        <field name="name">Skill Training</field><field name="sequence">90</field>
    </record>

    <record id="view_cp_performance_rating_tree" model="ir.ui.view">
        <field name="name">cp.performance.rating.tree</field>
        <field name="model">cp.performance.rating</field>
        <field name="arch" type="xml">
            <tree string="Performance Ratings" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="action_cp_performance_rating" model="ir.actions.act_window">
        <field name="name">Performance Ratings</field>
        <field name="res_model">cp.performance.rating</field>
        <field name="view_mode">tree</field>
    </record>

    <record id="rating_unsatisfactory" model="cp.performance.rating">
        <field name="name">Unsatisfactory</field><field name="sequence">10</field>
    </record>
    <record id="rating_less_satisfactory" model="cp.performance.rating">
        <field name="name">Less than Satisfactory</field><field name="sequence">20</field>
    </record>
    <record id="rating_fully_satisfactory" model="cp.performance.rating">
        <field name="name">Fully Satisfactory</field><field name="sequence">30</field>
    </record>
    <record id="rating_excellent" model="cp.performance.rating">
        <field name="name">Excellent</field><field name="sequence">40</field>
    </record>
    <record id="rating_outstanding" model="cp.performance.rating">
        <field name="name">Outstanding</field><field name="sequence">50</field>
    </record>

    <!-- Case Workers -->
    <record id="view_cp_case_worker_tree" model="ir.ui.view">
        <field name="name">cp.case.worker.tree</field>
        <field name="model">cp.case.worker</field>
        <field name="arch" type="xml">
            <tree string="Case Workers">
                <field name="employee_id"/>
                <field name="institution"/>
                <field name="location"/>
                <field name="id_no"/>
                <field name="code"/>
            </tree>
        </field>
    </record>

    <record id="view_cp_case_worker_form" model="ir.ui.view">
        <field name="name">cp.case.worker.form</field>
        <field name="model">cp.case.worker</field>
        <field name="arch" type="xml">
            <form string="Case Worker">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_cases" type="object"
                                class="oe_stat_button" icon="fa-folder-open"
                                invisible="case_count == 0">
                            <field name="case_count" widget="statinfo" string="Cases"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="code" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="institution"/>
                        </group>
                        <group>
                            <field name="location"/>
                            <field name="id_no"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_cp_case_worker" model="ir.actions.act_window">
        <field name="name">Case Workers</field>
        <field name="res_model">cp.case.worker</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Supervisors -->
    <record id="view_cp_supervisor_tree" model="ir.ui.view">
        <field name="name">cp.supervisor.tree</field>
        <field name="model">cp.supervisor</field>
        <field name="arch" type="xml">
            <tree string="Supervisors">
                <field name="generated_code"/>
                <field name="supervisor_name"/>
                <field name="mother_first_name"/>
                <field name="birth_date"/>
                <field name="place_of_birth"/>
            </tree>
        </field>
    </record>

    <record id="view_cp_supervisor_form" model="ir.ui.view">
        <field name="name">cp.supervisor.form</field>
        <field name="model">cp.supervisor</field>
        <field name="arch" type="xml">
            <form string="Supervisor">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_cases" type="object"
                                class="oe_stat_button" icon="fa-folder-open"
                                invisible="case_count == 0">
                            <field name="case_count" widget="statinfo" string="Cases"/>
                        </button>
                    </div>
                    <field name="photo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="supervisor_name" placeholder="Supervisor Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="mother_first_name"/>
                            <field name="birth_date"/>
                        </group>
                        <group>
                            <field name="birth_order"/>
                            <field name="place_of_birth"/>
                            <field name="generated_code" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_cp_supervisor" model="ir.actions.act_window">
        <field name="name">Supervisors</field>
        <field name="res_model">cp.supervisor</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_cp_configuration" name="Configuration"
              parent="menu_cp_root" sequence="90"/>
    <menuitem id="menu_cp_case_worker" name="Case Workers"
              parent="menu_cp_configuration" action="action_cp_case_worker"
              sequence="4"/>
    <menuitem id="menu_cp_supervisor" name="Supervisors"
              parent="menu_cp_configuration" action="action_cp_supervisor"
              sequence="5"/>
    <menuitem id="menu_cp_partner_agency" name="Partner Agencies"
              parent="menu_cp_configuration" action="action_cp_partner_agency"
              sequence="10"/>
    <menuitem id="menu_cp_event_type" name="Event Types"
              parent="menu_cp_configuration" action="action_cp_event_type"
              sequence="25"/>
    <menuitem id="menu_cp_performance_rating" name="Performance Ratings"
              parent="menu_cp_configuration" action="action_cp_performance_rating"
              sequence="30"/>
    <menuitem id="menu_cp_basic_need" name="Basic Needs"
              parent="menu_cp_configuration" action="action_cp_basic_need"
              sequence="20"/>
</odoo>
