<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Visible category so the groups are assignable on the user form. -->
    <record id="module_category_cp" model="ir.module.category">
        <field name="name">Child Protection</field>
        <field name="sequence">21</field>
    </record>

    <!-- Access to the Street Children Cases menu only. -->
    <record id="group_cp_street" model="res.groups">
        <field name="name">Street Children Cases</field>
        <field name="category_id" ref="module_category_cp"/>
    </record>

    <!-- Access to the CAAFAG menu only. -->
    <record id="group_cp_caafag" model="res.groups">
        <field name="name">CAAFAG</field>
        <field name="category_id" ref="module_category_cp"/>
    </record>

    <!-- Manager sees both menus (implies the two type groups). -->
    <record id="group_cp_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_cp"/>
        <field name="implied_ids"
               eval="[(4, ref('group_cp_street')), (4, ref('group_cp_caafag'))]"/>
        <field name="users"
               eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
    </record>

</odoo>
