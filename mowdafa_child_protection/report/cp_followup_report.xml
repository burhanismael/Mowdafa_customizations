<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- Follow-up Visit Form — printed with the generic form layout (mowdafa_extended/report/mowdafa_form_layout.xml) -->
<template id="report_form_cp_followup">
  <t t-call="mowdafa_extended.report_mowdafa_form_document"/>
</template>

<record id="action_report_form_cp_followup" model="ir.actions.report">
  <field name="name">Follow-up Visit Form</field>
  <field name="model">cp.followup</field>
  <field name="report_type">qweb-pdf</field>
  <field name="report_name">mowdafa_child_protection.report_form_cp_followup</field>
  <field name="report_file">mowdafa_child_protection.report_form_cp_followup</field>
  <field name="print_report_name">'Follow-up Visit Form - %s' % (object.display_name)</field>
  <field name="binding_model_id" ref="model_cp_followup"/>
  <field name="binding_type">report</field>
</record>

</odoo>
