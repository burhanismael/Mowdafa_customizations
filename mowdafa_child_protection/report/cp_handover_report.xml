<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- The hand-over certificate (CP-06) — built on the shared MOWDAFA
     form-report design (mowdafa_extended/report/mowdafa_form_layout.xml),
     sections as on the hand-over form. Street Children and CAAFAG. -->
<template id="report_cp_handover_document">
  <t t-call="web.html_container">
    <t t-foreach="docs" t-as="doc">
      <t t-set="o" t-value="doc"/>
      <t t-call="web.external_layout">
        <t t-set="helper" t-value="doc.env['mowdafa.pdf.helper']"/>
        <div class="page mr-page">
          <t t-call="mowdafa_extended.report_mowdafa_styles"/>
          <t t-call="mowdafa_extended.report_mowdafa_title">
            <t t-set="mr_doctype" t-value="'Child Hand-over Form (CP-06)'"/>
            <t t-set="mr_ref" t-value="doc.name"/>
            <t t-set="mr_sub" t-value="doc.child_full_name"/>
            <t t-set="mr_badge_lbl" t-value="'This form certifies the child was'"/>
            <t t-set="mr_badge" t-value="helper._fmt(doc, doc._fields['direction'])"/>
          </t>

          <div class="mr-sec">1 · The Child</div>
          <t t-call="mowdafa_extended.report_mowdafa_rows">
            <t t-set="mr_rows" t-value="helper.grid(doc, [
                ('Case', 'case_id'), ('Father\'s Name', 'child_father'),
                ('Full Name', 'child_full_name'), ('Nationality', 'child_nationality'),
                ('Sex', 'child_sex'), ('Case Worker', 'case_worker_id'),
                ('Date of Birth', 'child_dob'), ('Supervisor', 'supervisor_id'),
                ('DOB Estimated?', 'child_dob_estimated'), ('Date &amp; Time', 'handover_datetime')])"/>
          </t>

          <div class="mr-sec">2 · From — Handed Over By</div>
          <t t-call="mowdafa_extended.report_mowdafa_rows">
            <t t-set="mr_rows" t-value="helper.grid(doc, [
                ('Full Name', 'by_name'), ('Position / Title', 'by_position'),
                ('Organisation', 'by_organisation'), ('Location', 'by_location'),
                ('Contact', 'by_contact')])"/>
          </t>

          <div class="mr-sec">3 · To — Received By</div>
          <t t-call="mowdafa_extended.report_mowdafa_rows">
            <t t-set="mr_rows" t-value="helper.grid(doc, [
                ('Institution', 'to_institution'), ('Name of MOWDAFA staff', 'received_by'),
                ('Location', 'to_location'), ('Role', 'received_role'),
                ('Child was handed over to', 'handed_to_type'), ('Contact', 'received_contact')]
                + ([('If Other, specify', 'handed_to_other')] if doc.handed_to_type == 'other' else [])
                + [('Complete Address', 'received_address')])"/>
          </t>

          <!-- signing block: one column per signatory, kept together -->
          <t t-set="cards" t-value="[
              ('Handing Over', doc.by_name, doc.by_position, doc.sign_handing_over, doc.sign_handing_over_img),
              ('Child', doc.child_full_name, doc.child_title, doc.sign_child, doc.sign_child_img),
              ('Receiver', doc.received_by, doc.received_role, doc.sign_receiver, doc.sign_receiver_img),
              ('Witness', doc.witness_name, doc.witness_role, doc.sign_witness, doc.sign_witness_img),
          ]"/>
          <div class="mr-keep">
            <div class="mr-sec">4 · Signatures — Chain of Custody</div>
            <table class="mr-tbl">
              <tr>
                <th style="width: 13%;"/>
                <t t-foreach="cards" t-as="card">
                  <th style="text-align: center;"><t t-esc="card[0]"/></th>
                </t>
              </tr>
              <tr>
                <td class="mr-rl">Name</td>
                <t t-foreach="cards" t-as="card"><td><t t-esc="card[1] or ''"/></td></t>
              </tr>
              <tr>
                <td class="mr-rl">Title</td>
                <t t-foreach="cards" t-as="card"><td><t t-esc="card[2] or ''"/></td></t>
              </tr>
              <tr>
                <td class="mr-rl">Signature</td>
                <t t-foreach="cards" t-as="card"><td><t t-esc="card[3] or ''"/></td></t>
              </tr>
              <tr>
                <td class="mr-rl">Signed</td>
                <t t-foreach="cards" t-as="card">
                  <td class="mr-sign">
                    <img t-if="card[4]" class="mr-sign-img"
                         t-att-src="image_data_uri(card[4])" alt="Signature"/>
                    <div class="mr-sign-line">Signature</div>
                  </td>
                </t>
              </tr>
              <tr>
                <td class="mr-rl">Date</td>
                <t t-foreach="cards" t-as="card">
                  <td><t t-esc="helper._fmt(doc, doc._fields['sign_date'])"/></td>
                </t>
              </tr>
            </table>
          </div>

          <div class="mr-sec">Notes</div>
          <t t-call="mowdafa_extended.report_mowdafa_rows">
            <t t-set="mr_rows" t-value="helper.grid(doc, [('Notes', 'notes')])"/>
          </t>
        </div>
      </t>
    </t>
  </t>
</template>


<!-- Hand-over Form -->
<template id="report_form_cp_handover">
  <t t-call="mowdafa_child_protection.report_cp_handover_document"/>
</template>

<record id="action_report_form_cp_handover" model="ir.actions.report">
  <field name="name">Hand-over Form</field>
  <field name="model">cp.handover</field>
  <field name="report_type">qweb-pdf</field>
  <field name="report_name">mowdafa_child_protection.report_form_cp_handover</field>
  <field name="report_file">mowdafa_child_protection.report_form_cp_handover</field>
  <field name="print_report_name">'Hand-over Form - %s' % (object.display_name)</field>
  <field name="binding_model_id" ref="model_cp_handover"/>
  <field name="binding_type">report</field>
</record>

<!-- CAAFAG Hand-over Form -->
<template id="report_form_cp_caafag_handover">
  <t t-call="mowdafa_child_protection.report_cp_handover_document"/>
</template>

<record id="action_report_form_cp_caafag_handover" model="ir.actions.report">
  <field name="name">CAAFAG Hand-over Form</field>
  <field name="model">cp.caafag.handover</field>
  <field name="report_type">qweb-pdf</field>
  <field name="report_name">mowdafa_child_protection.report_form_cp_caafag_handover</field>
  <field name="report_file">mowdafa_child_protection.report_form_cp_caafag_handover</field>
  <field name="print_report_name">'CAAFAG Hand-over Form - %s' % (object.display_name)</field>
  <field name="binding_model_id" ref="model_cp_caafag_handover"/>
  <field name="binding_type">report</field>
</record>

</odoo>
