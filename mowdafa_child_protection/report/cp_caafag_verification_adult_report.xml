<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- CAAFAG Adult Verification Form — printed with the generic form layout (mowdafa_extended/report/mowdafa_form_layout.xml) -->
<template id="report_form_cp_caafag_verification_adult">
  <t t-call="mowdafa_extended.report_mowdafa_form_document"/>
</template>

<record id="action_report_form_cp_caafag_verification_adult" model="ir.actions.report">
  <field name="name">CAAFAG Adult Verification Form</field>
  <field name="model">cp.caafag.verification.adult</field>
  <field name="report_type">qweb-pdf</field>
  <field name="report_name">mowdafa_child_protection.report_form_cp_caafag_verification_adult</field>
  <field name="report_file">mowdafa_child_protection.report_form_cp_caafag_verification_adult</field>
  <field name="print_report_name">'CAAFAG Adult Verification Form - %s' % (object.display_name)</field>
  <field name="binding_model_id" ref="model_cp_caafag_verification_adult"/>
  <field name="binding_type">report</field>
</record>

</odoo>
