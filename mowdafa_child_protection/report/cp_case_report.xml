<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- The case file — built on the shared MOWDAFA form-report design
     (mowdafa_extended/report/mowdafa_form_layout.xml), sections as on
     the case form. Shared by Street Children and CAAFAG cases. -->
<template id="report_cp_case_document">
  <t t-call="web.html_container">
    <t t-foreach="docs" t-as="doc">
      <t t-set="o" t-value="doc"/>
      <t t-call="web.external_layout">
        <t t-set="helper" t-value="doc.env['mowdafa.pdf.helper']"/>
        <div class="page mr-page">
          <t t-call="mowdafa_extended.report_mowdafa_styles"/>
          <t t-call="mowdafa_extended.report_mowdafa_title">
            <t t-set="mr_doctype" t-value="doc._description"/>
            <t t-set="mr_ref" t-value="doc.name"/>
            <t t-set="mr_sub" t-value="doc.child_name"/>
            <t t-set="mr_badge_lbl" t-value="'Current stage'"/>
            <t t-set="mr_badge" t-value="helper._fmt(doc, doc._fields['stage'])"/>
            <t t-set="mr_photo" t-value="doc.photo"/>
          </t>

          <div class="mr-sec">1 · Child Identification</div>
          <t t-call="mowdafa_extended.report_mowdafa_rows">
            <t t-set="mr_rows" t-value="helper.grid(doc, [
                ('First Name', 'first_name'), ('Sex', 'sex'),
                ('Middle / Father\'s Name', 'middle_name'), ('Date of Birth', 'date_of_birth'),
                ('Last / Grandfather\'s Name', 'last_name'), ('DOB Estimated?', 'dob_estimated'),
                ('Other Name(s)', 'other_names'), ('Age (years)', 'age_years'),
                ('Full Name', 'child_name'), ('Nationality', 'nationality_id'),
                ('Nickname', 'nickname'), ('Population Group', 'population_group'),
                ('Disability', 'disability')])"/>
          </t>

          <div class="mr-sec">2 · Location — for the report</div>
          <t t-call="mowdafa_extended.report_mowdafa_rows">
            <t t-set="mr_rows" t-value="helper.grid(doc, [
                ('Country', 'country_id'), ('Camp / Settlement', 'camp'),
                ('Region', 'region_id'), ('Date Identified', 'date_identified'),
                ('District', 'district_id'), ('Referral Source', 'referral_source_id'),
                ('Village / Section', 'village')])"/>
          </t>

          <div class="mr-sec">3 · Protection Concern &amp; Safety</div>
          <t t-call="mowdafa_extended.report_mowdafa_rows">
            <t t-set="mr_rows" t-value="helper.grid(doc, [
                ('Primary Concern', 'protection_concern_id'), ('Risk Level', 'risk_level'),
                ('Immediate Risk?', 'immediate_risk'),
                ('Concern Description', 'concern_description'),
                ('Risk Factors', 'risk_factors')])"/>
          </t>

          <div class="mr-sec">4 · Case Management — MOWDAFA</div>
          <t t-call="mowdafa_extended.report_mowdafa_rows">
            <t t-set="mr_rows" t-value="helper.grid(doc, [
                ('Case Worker', 'case_worker_id'), ('Placement', 'placement_type'),
                ('Supervisor', 'supervisor_id'), ('Recommendation', 'recommendation')])"/>
          </t>

          <t t-if="doc.verification_conflict or doc.supervisor_decision">
            <div class="mr-sec">Verification Gate</div>
            <t t-call="mowdafa_extended.report_mowdafa_rows">
              <t t-set="mr_rows" t-value="helper.grid(doc, [
                  ('Accounts Disagree', 'verification_conflict'),
                  ('Supervisor Decision', 'supervisor_decision'),
                  ('Reason', 'supervisor_reason')])"/>
            </t>
          </t>

          <div class="mr-sec">Notes</div>
          <t t-call="mowdafa_extended.report_mowdafa_rows">
            <t t-set="mr_rows" t-value="helper.grid(doc, [('Notes', 'notes')])"/>
          </t>
        </div>
      </t>
    </t>
  </t>
</template>


<!-- Case Form -->
<template id="report_form_cp_case">
  <t t-call="mowdafa_child_protection.report_cp_case_document"/>
</template>

<record id="action_report_form_cp_case" model="ir.actions.report">
  <field name="name">Case Form</field>
  <field name="model">cp.case</field>
  <field name="report_type">qweb-pdf</field>
  <field name="report_name">mowdafa_child_protection.report_form_cp_case</field>
  <field name="report_file">mowdafa_child_protection.report_form_cp_case</field>
  <field name="print_report_name">'Case Form - %s' % (object.display_name)</field>
  <field name="binding_model_id" ref="model_cp_case"/>
  <field name="binding_type">report</field>
</record>

<!-- CAAFAG Case Form -->
<template id="report_form_cp_caafag_case">
  <t t-call="mowdafa_child_protection.report_cp_case_document"/>
</template>

<record id="action_report_form_cp_caafag_case" model="ir.actions.report">
  <field name="name">CAAFAG Case Form</field>
  <field name="model">cp.caafag.case</field>
  <field name="report_type">qweb-pdf</field>
  <field name="report_name">mowdafa_child_protection.report_form_cp_caafag_case</field>
  <field name="report_file">mowdafa_child_protection.report_form_cp_caafag_case</field>
  <field name="print_report_name">'CAAFAG Case Form - %s' % (object.display_name)</field>
  <field name="binding_model_id" ref="model_cp_caafag_case"/>
  <field name="binding_type">report</field>
</record>

</odoo>
