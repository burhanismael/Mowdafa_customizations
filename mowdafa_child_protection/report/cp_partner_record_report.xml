<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- Partner Record Form — printed with the generic form layout (mowdafa_extended/report/mowdafa_form_layout.xml) -->
<template id="report_form_cp_partner_record">
  <t t-call="mowdafa_extended.report_mowdafa_form_document"/>
</template>

<record id="action_report_form_cp_partner_record" model="ir.actions.report">
  <field name="name">Partner Record Form</field>
  <field name="model">cp.partner.record</field>
  <field name="report_type">qweb-pdf</field>
  <field name="report_name">mowdafa_child_protection.report_form_cp_partner_record</field>
  <field name="report_file">mowdafa_child_protection.report_form_cp_partner_record</field>
  <field name="print_report_name">'Partner Record Form - %s' % (object.display_name)</field>
  <field name="binding_model_id" ref="model_cp_partner_record"/>
  <field name="binding_type">report</field>
</record>

</odoo>
