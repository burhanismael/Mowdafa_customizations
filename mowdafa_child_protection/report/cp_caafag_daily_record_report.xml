<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- CAAFAG Performance Record Form — printed with the generic form layout (mowdafa_extended/report/mowdafa_form_layout.xml) -->
<template id="report_form_cp_caafag_daily_record">
  <t t-call="mowdafa_extended.report_mowdafa_form_document"/>
</template>

<record id="action_report_form_cp_caafag_daily_record" model="ir.actions.report">
  <field name="name">CAAFAG Performance Record Form</field>
  <field name="model">cp.caafag.daily.record</field>
  <field name="report_type">qweb-pdf</field>
  <field name="report_name">mowdafa_child_protection.report_form_cp_caafag_daily_record</field>
  <field name="report_file">mowdafa_child_protection.report_form_cp_caafag_daily_record</field>
  <field name="print_report_name">'CAAFAG Performance Record Form - %s' % (object.display_name)</field>
  <field name="binding_model_id" ref="model_cp_caafag_daily_record"/>
  <field name="binding_type">report</field>
</record>

</odoo>
