<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Force Documents' record rules onto a purely USER-BASED form.
        The original rules live in the documents module's noupdate="1"
        blocks, so instead of relying on a <record> override we call a
        method that rewrites their domains on every module update.

        Result: a workspace and its documents are reachable only through
        the workspace's Read Users / Write Users (a document's owner keeps
        access to their own; Documents Managers still see everything).
    -->
    <function model="ir.rule" name="_apply_documents_user_based"/>

</odoo>
