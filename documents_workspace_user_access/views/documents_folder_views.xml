<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="documents_folder_view_form_user_access" model="ir.ui.view">
        <field name="name">documents.folder.form.user.access</field>
        <field name="model">documents.folder</field>
        <field name="inherit_id" ref="documents.folder_view_form"/>
        <field name="arch" type="xml">
            <!-- Write Users under the write groups -->
            <xpath expr="//field[@name='user_specific_write']" position="after">
                <field name="write_user_ids" widget="many2many_tags"
                       options="{'no_create_edit': True}"/>
            </xpath>
            <!-- Read Users under the read groups -->
            <xpath expr="//field[@name='user_specific']" position="after">
                <field name="read_user_ids" widget="many2many_tags"
                       options="{'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>

</odoo>
